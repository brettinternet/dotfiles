### Local exports ###

# One-time setup: ATUIN_SYNC_ADDRESS=https://atuin.example.com ./install
# The installer persists the address in ~/.config/atuin/config.toml.
# export DOTFILES_AI_TOOLS=all # or: pi,omp,opencode,claude,codex,amp
# export MY_WALLPAPERS=$HOME/walls
# export GIT_CONFIG_COUNT=1
# export GIT_CONFIG_KEY_0="user.email"
# export GIT_CONFIG_VALUE_0="local@example.com"
