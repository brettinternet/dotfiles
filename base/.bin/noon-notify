#!/usr/bin/env bash
# Noon on_failure hook: tells you a scheduled job failed, once per failure streak, through Tell.
# Quietly does nothing when no Tell config routes the message; never fails the hook.
#   on_failure: [noon-notify, It may be waiting on you.]
# Loads ~/.envrc via direnv so delivery secrets such as APPRISE_URLS stay out of config.
set -u

# Noon before 0.5 does not set the streak count; treat that as a first failure.
streak=${NOON_CONSECUTIVE_FAILURES:-1}
[[ $streak =~ ^[0-9]+$ ]] && ((streak <= 1)) || exit 0

tell_() {
  if command -v direnv >/dev/null && [[ -f $HOME/.envrc ]]; then
    direnv exec "$HOME" tell "$@"
  else
    tell "$@"
  fi
}

sources=$(tell_ --json config 2>/dev/null | jq -r '.config.sources | length' 2>/dev/null)
[[ ${sources:-0} =~ ^[1-9] ]] || exit 0

message="noon ${NOON_JOB:-job} ${NOON_STATUS:-failed}. See noon logs ${NOON_RUN_ID:-}."
[[ $# -eq 0 ]] || message+=" $*"
tell_ --timeout 10s notify --type failure "$message" >/dev/null 2>&1
exit 0
