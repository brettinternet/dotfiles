#!/usr/bin/env python3

import json
import os
import re
import sys
from pathlib import Path
from urllib.parse import urlsplit


def main() -> int:
    sync_address = os.environ.get("ATUIN_SYNC_ADDRESS", "")
    if not sync_address:
        return 0

    parsed_address = urlsplit(sync_address)
    if parsed_address.scheme not in {"http", "https"} or not parsed_address.netloc:
        print("ATUIN_SYNC_ADDRESS must be an absolute HTTP(S) URL", file=sys.stderr)
        return 1

    config_dir = Path(
        os.environ.get("ATUIN_CONFIG_DIR", Path.home() / ".config/atuin")
    )
    config_path = config_dir / "config.toml"
    config_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    config_dir.chmod(0o700)

    contents = config_path.read_text() if config_path.exists() else ""
    setting = f"sync_address = {json.dumps(sync_address)}"
    pattern = re.compile(r"^[ \t]*sync_address[ \t]*=.*$", re.MULTILINE)
    if pattern.search(contents):
        contents = pattern.sub(setting, contents, count=1)
    else:
        contents = f"{setting}\n{contents}"

    temporary_path = config_path.with_name(f".{config_path.name}.{os.getpid()}.tmp")
    try:
        descriptor = os.open(
            temporary_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600
        )
        with os.fdopen(descriptor, "w") as temporary:
            temporary.write(contents)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary_path, config_path)
    finally:
        if temporary_path.exists():
            temporary_path.unlink()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
