#!/usr/bin/env bash

set -u

usage() {
  cat <<'EOF'
Usage: context-editor [--mode MODE] FILE
       context-editor --child FILE COMPLETION_FILE NVIM

Open an external-editor file without covering the calling pane when possible.

Modes:
  auto         Herdr or tmux pane when reachable; current terminal over SSH;
               otherwise Ghostty on macOS, VS Code, or current terminal
  ask          Prompt for a mode
  herdr-pane   Neovim in a new pane beside the current Herdr pane
  herdr-tab    Neovim in a new tab in the current Herdr workspace
  tmux-pane    Neovim in a new pane beside the current tmux pane
  ghostty      Neovim in a new Ghostty window (macOS)
  code         VS Code using --wait
  terminal     Neovim in the current terminal

CONTEXT_EDITOR_MODE sets the default mode (default: auto).
CONTEXT_EDITOR_NVIM and CONTEXT_EDITOR_CODE override the nvim/code executables.
CONTEXT_EDITOR_GHOSTTY_APP overrides the Ghostty application path.
EOF
}

die() {
  printf 'context-editor: %s\n' "$*" >&2
  exit 1
}

is_remote() {
  [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_TTY:-}" || -n "${SSH_CLIENT:-}" ]]
}

herdr_context() {
  [[ "${HERDR_ENV:-}" == "1" ]] || return 1
  [[ -n "${HERDR_PANE_ID:-}" ]] || return 1
  command -v herdr >/dev/null 2>&1 || return 1
  command -v jq >/dev/null 2>&1 || return 1

  local response pane_id
  response="$(herdr pane current --current 2>/dev/null)" || return 1
  pane_id="$(jq -er '.result.pane.pane_id' <<<"$response" 2>/dev/null)" || return 1
  [[ -n "$pane_id" ]]
}

herdr_split_direction() {
  local layout direction
  layout="$(herdr pane layout --pane "$HERDR_PANE_ID" 2>/dev/null)" || {
    printf '%s\n' right
    return
  }
  direction="$(
    jq -er --arg pane "$HERDR_PANE_ID" '
      first(
        .result.layout.panes[]?
        | select(.pane_id == $pane)
        | .rect
        | select((.width | type) == "number" and (.height | type) == "number")
        | select(.width > 0 and .height > 0)
      )
      | if .height * 2 > .width then "down" else "right" end
    ' <<<"$layout" 2>/dev/null
  )" || direction=right
  printf '%s\n' "$direction"
}

tmux_context() {
  [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || return 1
  command -v tmux >/dev/null 2>&1 || return 1

  local pane_id
  pane_id="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_id}' 2>/dev/null)" || return 1
  [[ "$pane_id" == "$TMUX_PANE" ]]
}

ghostty_app() {
  if [[ -n "${CONTEXT_EDITOR_GHOSTTY_APP:-}" ]]; then
    printf '%s\n' "$CONTEXT_EDITOR_GHOSTTY_APP"
  elif [[ -d /Applications/Ghostty.app ]]; then
    printf '%s\n' /Applications/Ghostty.app
  elif [[ -d "$HOME/Applications/Ghostty.app" ]]; then
    printf '%s\n' "$HOME/Applications/Ghostty.app"
  else
    return 1
  fi
}

resolve_auto_mode() {
  if herdr_context; then
    printf '%s\n' herdr-pane
    return
  fi

  if tmux_context; then
    printf '%s\n' tmux-pane
    return
  fi

  if is_remote; then
    if [[ "${HERDR_ENV:-}" == "1" ]]; then
      printf 'context-editor: Herdr control is unavailable; using current-terminal Neovim over SSH\n' >&2
    elif [[ -n "${TMUX:-}" ]]; then
      printf 'context-editor: tmux control is unavailable; using current-terminal Neovim over SSH\n' >&2
    fi
    printf '%s\n' terminal
    return
  fi

  if [[ "$(uname -s)" == "Darwin" ]] && command -v osascript >/dev/null 2>&1 && ghostty_app >/dev/null; then
    printf '%s\n' ghostty
  elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v "${CONTEXT_EDITOR_CODE:-code}" >/dev/null 2>&1; then
    printf '%s\n' code
  else
    printf '%s\n' terminal
  fi
}

choose_mode() {
  local choice
  cat >/dev/tty <<'EOF'
Open editor in:
  [p] Herdr pane
  [h] Herdr tab
  [m] tmux pane
  [g] Ghostty window
  [c] VS Code
  [t] Current terminal
Choice:
EOF
  IFS= read -r choice </dev/tty || die "could not read editor choice"
  case "$choice" in
    p|P) printf '%s\n' herdr-pane ;;
    h|H) printf '%s\n' herdr-tab ;;
    m|M) printf '%s\n' tmux-pane ;;
    g|G) printf '%s\n' ghostty ;;
    c|C) printf '%s\n' code ;;
    t|T) printf '%s\n' terminal ;;
    *) die "unknown editor choice: $choice" ;;
  esac
}

child_interrupted() {
  printf '129\n' >"$completion_file"
  exit 129
}

run_child() {
  local file=$1 completion_file=$2 nvim=$3 status
  trap child_interrupted HUP INT TERM
  "$nvim" "$file"
  status=$?
  printf '%s\n' "$status" >"$completion_file"
  exit "$status"
}

wait_for_child() {
  local completion_file=$1 status
  while [[ ! -s "$completion_file" ]]; do
    sleep 0.1
  done
  IFS= read -r status <"$completion_file"
  [[ "$status" =~ ^[0-9]+$ ]] || status=1
  return "$status"
}

shell_join() {
  local argument quoted command=''
  for argument in "$@"; do
    printf -v quoted '%q' "$argument"
    command+="${command:+ }$quoted"
  done
  printf '%s\n' "$command"
}

run_herdr() {
  local kind=$1 file=$2 nvim=$3 created pane_id='' tab_id='' current workspace_id direction completion_file child_command status=0
  herdr_context || die "mode '$kind' requires a reachable current Herdr pane"
  completion_file="$(mktemp "${TMPDIR:-/tmp}/context-editor.XXXXXX")" || die "could not create completion file"
  : >"$completion_file"

  cleanup_herdr() {
    if [[ -n "$tab_id" ]]; then
      herdr tab close "$tab_id" >/dev/null 2>&1 || true
    elif [[ -n "$pane_id" ]]; then
      herdr pane close "$pane_id" >/dev/null 2>&1 || true
    fi
    [[ ! -e "$completion_file" ]] || unlink "$completion_file"
  }
  abort_herdr() {
    cleanup_herdr
    trap - EXIT HUP INT TERM
    exit 130
  }
  trap cleanup_herdr EXIT
  trap abort_herdr HUP INT TERM

  if [[ "$kind" == "herdr-tab" ]]; then
    current="$(herdr pane current --current 2>/dev/null)" || die "could not read current Herdr pane"
    workspace_id="$(jq -er '.result.pane.workspace_id' <<<"$current")" || die "Herdr did not return the current workspace"
    created="$(herdr tab create --workspace "$workspace_id" --cwd "$PWD" --label editor --focus)" || die "could not create Herdr tab"
    pane_id="$(jq -er '.result.root_pane.pane_id' <<<"$created")" || die "Herdr did not return a root pane"
    tab_id="$(jq -er '.result.tab.tab_id' <<<"$created")" || die "Herdr did not return a tab"
  else
    direction="$(herdr_split_direction)"
    created="$(herdr pane split "$HERDR_PANE_ID" --direction "$direction" --cwd "$PWD" --focus)" || die "could not split current Herdr pane"
    pane_id="$(jq -er '.result.pane.pane_id' <<<"$created")" || die "Herdr did not return a pane"
  fi

  child_command="$(shell_join "$self" --child "$file" "$completion_file" "$nvim")"
  herdr pane run "$pane_id" "$child_command" >/dev/null || die "could not start Neovim in Herdr pane $pane_id"
  wait_for_child "$completion_file" || status=$?
  cleanup_herdr
  trap - EXIT HUP INT TERM
  return "$status"
}

run_tmux() {
  local file=$1 nvim=$2 pane_id='' completion_file child_command status=0
  tmux_context || die "mode 'tmux-pane' requires a reachable current tmux pane"
  completion_file="$(mktemp "${TMPDIR:-/tmp}/context-editor.XXXXXX")" || die "could not create completion file"
  : >"$completion_file"

  cleanup_tmux() {
    if [[ -n "$pane_id" ]]; then
      tmux kill-pane -t "$pane_id" >/dev/null 2>&1 || true
    fi
    [[ ! -e "$completion_file" ]] || unlink "$completion_file"
  }
  abort_tmux() {
    cleanup_tmux
    trap - EXIT HUP INT TERM
    exit 130
  }
  trap cleanup_tmux EXIT
  trap abort_tmux HUP INT TERM

  child_command="$(shell_join "$self" --child "$file" "$completion_file" "$nvim")"
  pane_id="$(tmux split-window -h -t "$TMUX_PANE" -P -F '#{pane_id}' -c "$PWD" "$child_command")" ||
    die "could not split current tmux pane"
  wait_for_child "$completion_file" || status=$?
  cleanup_tmux
  trap - EXIT HUP INT TERM
  return "$status"
}

run_ghostty() {
  local file=$1 nvim=$2 completion_file terminal_id='' status=0
  [[ "$(uname -s)" == "Darwin" ]] || die "mode 'ghostty' is only supported on macOS"
  command -v osascript >/dev/null 2>&1 || die "mode 'ghostty' requires osascript"
  ghostty_app >/dev/null || die "Ghostty.app was not found"
  completion_file="$(mktemp "${TMPDIR:-/tmp}/context-editor.XXXXXX")" || die "could not create completion file"
  : >"$completion_file"

  cleanup_ghostty() {
    if [[ -n "$terminal_id" ]]; then
      osascript - "$terminal_id" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  set terminalId to item 1 of argv
  tell application "Ghostty"
    close (first terminal whose id is terminalId)
  end tell
end run
APPLESCRIPT
    fi
    [[ ! -e "$completion_file" ]] || unlink "$completion_file"
  }
  abort_ghostty() {
    cleanup_ghostty
    trap - EXIT HUP INT TERM
    exit 130
  }
  trap cleanup_ghostty EXIT
  trap abort_ghostty HUP INT TERM

  terminal_id="$(osascript - "$self" "$file" "$completion_file" "$PWD" "$nvim" <<'APPLESCRIPT'
on run argv
  set editorPath to item 1 of argv
  set promptPath to item 2 of argv
  set completionPath to item 3 of argv
  set workingDirectory to item 4 of argv
  set nvimPath to item 5 of argv
  set commandText to quoted form of editorPath & " --child " & quoted form of promptPath & " " & quoted form of completionPath & " " & quoted form of nvimPath
  tell application "Ghostty"
    set editorWindow to new window with configuration {command:commandText, initial working directory:workingDirectory, wait after command:false}
    activate
    return id of first terminal of editorWindow
  end tell
end run
APPLESCRIPT
  )" || die "could not open Ghostty editor window"
  [[ -n "$terminal_id" ]] || die "Ghostty did not return the created terminal"

  wait_for_child "$completion_file" || status=$?
  cleanup_ghostty
  trap - EXIT HUP INT TERM
  return "$status"
}

mode="${CONTEXT_EDITOR_MODE:-auto}"
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--child" ]]; then
  [[ $# -eq 4 ]] || die "--child requires FILE, COMPLETION_FILE, and NVIM"
  run_child "$2" "$3" "$4"
fi
if [[ "${1:-}" == "--mode" ]]; then
  [[ $# -ge 3 ]] || die "--mode requires MODE and FILE"
  mode=$2
  shift 2
fi
[[ $# -eq 1 ]] || die "expected one file; run context-editor --help for usage"
file=$1
[[ -e "$file" ]] || die "file does not exist: $file"
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

[[ "$mode" != "auto" ]] || mode="$(resolve_auto_mode)"
[[ "$mode" != "ask" ]] || mode="$(choose_mode)"

nvim=''
case "$mode" in
  herdr-pane|herdr-tab|tmux-pane|ghostty|terminal)
    nvim="$(command -v "${CONTEXT_EDITOR_NVIM:-nvim}")" ||
      die "Neovim executable not found: ${CONTEXT_EDITOR_NVIM:-nvim}"
    ;;
esac

case "$mode" in
  herdr-pane|herdr-tab) run_herdr "$mode" "$file" "$nvim" ;;
  tmux-pane) run_tmux "$file" "$nvim" ;;
  ghostty) run_ghostty "$file" "$nvim" ;;
  code) "${CONTEXT_EDITOR_CODE:-code}" --wait "$file" ;;
  terminal) "$nvim" "$file" ;;
  *) die "unknown mode '$mode'" ;;
esac
