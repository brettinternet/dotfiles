" -- vim-plug ----------------------------------------

" Plugins for real Vim only; Neovim is configured separately under
" ~/.config/nvim. Keep this list slim: it is the fallback for machines that
" only have vim. Bootstrap vim-plug, then :PlugInstall (see ~/.vimrc).

call plug#begin('~/.vim/plugged')

" Theme. Must be a Vimscript colorscheme; Lua-only Neovim themes such as
" navarasu/onedark.nvim silently fail to load in Vim.
Plug 'sainnhe/gruvbox-material'

" Tooling
Plug 'vim-airline/vim-airline'                              " Status line, written in Vimscript
Plug 'airblade/vim-gitgutter'                               " Shows a git diff in the sign column
Plug 'preservim/nerdtree', { 'on':  'NERDTreeToggle' }      " Tree explorer for navigating the filesystem
Plug 'preservim/nerdcommenter'                              " Easy commenting of code for many filetypes
Plug 'austintaylor/vim-indentobject'                        " Text objects based on indent levels
Plug 'christoomey/vim-tmux-navigator'                       " Move between vim splits and tmux panes
Plug 'ctrlpvim/ctrlp.vim'                                   " Fuzzy file, buffer, mru, tag finder
Plug 'preservim/tagbar'                                     " Browse the tags of the current file

" Linting. ALE only: running ALE and syntastic together double-reports
" diagnostics and fights over the sign column.
Plug 'dense-analysis/ale'                                   " Asynchronous Lint Engine

Plug 'tpope/vim-fugitive'                                   " Git wrapper so awesome, it should be illegal
Plug 'tpope/vim-surround'                                   " Mappings to delete, change and add surroundings
Plug 'tpope/vim-repeat'                                     " Make `.` repeat surround/commentary maps
Plug 'tpope/vim-eunuch'                                     " Helpers for UNIX

" Language
Plug 'leafgarland/typescript-vim'
Plug 'pangloss/vim-javascript'

call plug#end()
