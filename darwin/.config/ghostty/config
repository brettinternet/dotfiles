# Styles
font-size = 16
font-family = "Ioskeley Mono"
macos-titlebar-style = tabs
macos-window-buttons = hidden
macos-titlebar-proxy-icon = hidden
theme = kaile

cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true

# Window
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-height = 50
window-width = 80
window-theme = dark
background-opacity = 1
background-blur = false

# Quick terminal
quick-terminal-position = left
quick-terminal-size = 40%,800px
quick-terminal-screen = mouse
quick-terminal-autohide = false
quick-terminal-space-behavior = remain
quick-terminal-animation-duration = 0
keybind = global:cmd+alt+semicolon=toggle_quick_terminal

# Behavior
confirm-close-surface = false
mouse-hide-while-typing = true
copy-on-select = false
clipboard-trim-trailing-spaces = true
bell-features = border
window-inherit-working-directory = false
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Keyboard
keybind = alt+backspace=text:\x1b\x7f
keybind = shift+enter=text:\n
# required for copying inside herdr
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
# Run from an empty shell prompt; use pane-local history inside Herdr.
keybind = super+shift+f=text:context-scrollback\x20
keybind = chain=write_scrollback_file:paste
keybind = chain=text:\n
