#!/bin/zsh

() {
  local gcloud_sdk_path="/opt/google-cloud-sdk"
  if [[ -f "$gcloud_sdk_path/path.zsh.inc" ]]; then
    source "$gcloud_sdk_path/path.zsh.inc"
  fi

  if [[ -f "$gcloud_sdk_path/completion.zsh.inc" ]]; then
    source "$gcloud_sdk_path/completion.zsh.inc"
  fi
}

# SSH sessions can't show Keychain prompts; unlock once so tools that store
# secrets in the login keychain (e.g. pi MCP OAuth) work.
() {
  local login_keychain="$HOME/Library/Keychains/login.keychain-db"
  if [[ -n $SSH_CONNECTION && -o interactive ]] &&
     ! security show-keychain-info "$login_keychain" &>/dev/null; then
    security unlock-keychain "$login_keychain"
  fi
}
