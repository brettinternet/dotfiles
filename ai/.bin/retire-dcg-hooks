#!/usr/bin/env python3
"""Remove the retired dcg hooks from Claude and Codex settings.

Claude relies on auto mode and Codex on its sandbox; only Pi still uses dcg.
"""
from __future__ import annotations

import json
import subprocess
import tempfile
from pathlib import Path
from typing import Any

HOME = Path.home()
STATE_FILE = HOME / ".local/state/dotfiles/dcg-guards.json"
STATE_MARKER = "Generated by install-dcg-guards."
CLAUDE_SETTINGS = HOME / ".claude/settings.json"
CODEX_HOOKS = HOME / ".codex/hooks.json"


def load(path: Path) -> dict[str, Any] | None:
    if not path.is_file() or path.is_symlink():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def write_json_atomic(path: Path, data: dict[str, Any]) -> None:
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, delete=False
    ) as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")
        temporary = Path(handle.name)
    temporary.chmod(path.stat().st_mode)
    temporary.replace(path)


def remove_hooks(data: dict[str, Any], command: str) -> bool:
    hooks = data.get("hooks")
    if not isinstance(hooks, dict) or not isinstance(hooks.get("PreToolUse"), list):
        return False
    changed = False
    retained: list[Any] = []
    for entry in hooks["PreToolUse"]:
        if not isinstance(entry, dict) or not isinstance(entry.get("hooks"), list):
            retained.append(entry)
            continue
        handlers = [
            handler
            for handler in entry["hooks"]
            if not (isinstance(handler, dict) and handler.get("command") == command)
        ]
        if len(handlers) != len(entry["hooks"]):
            changed = True
        if handlers:
            retained.append({**entry, "hooks": handlers})
    if retained:
        hooks["PreToolUse"] = retained
    else:
        hooks.pop("PreToolUse")
    if not hooks:
        data.pop("hooks")
    return changed


def remove_claude_env(data: dict[str, Any]) -> bool:
    env = data.get("env")
    if not isinstance(env, dict) or "DCG_POLICY_DEFAULT_MODE" not in env:
        return False
    env.pop("DCG_POLICY_DEFAULT_MODE")
    if not env:
        data.pop("env")
    return True


def managed_command() -> str | None:
    state = load(STATE_FILE)
    if state is None or state.get("marker") != STATE_MARKER:
        return None
    command = state.get("command")
    return command if isinstance(command, str) else None


def main() -> int:
    command = managed_command()

    claude = load(CLAUDE_SETTINGS)
    if claude is not None:
        changed = remove_claude_env(claude)
        if command and remove_hooks(claude, command):
            changed = True
        if changed:
            write_json_atomic(CLAUDE_SETTINGS, claude)

    codex = load(CODEX_HOOKS)
    if codex is not None and command and remove_hooks(codex, command):
        write_json_atomic(CODEX_HOOKS, codex)

    # configure-ai-tools still reads the state to retire old OMP/OpenCode guards.
    state = load(STATE_FILE)
    if command and state is not None and not state.get("guards"):
        subprocess.run(["trash", str(STATE_FILE)], check=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
