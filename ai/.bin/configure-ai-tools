#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import shutil
import subprocess
from pathlib import Path

TOOLS = {
    "pi": (
        '"npm:@earendil-works/pi-coding-agent"',
        '{ version = "latest", minimum_release_age = "0" }',
    ),
    "claude": (
        '"npm:@anthropic-ai/claude-code"',
        '{ version = "latest", minimum_release_age = "0" }',
    ),
    "codex": ("codex", '"latest"'),
    "amp": (
        "amp",
        '{ version = "latest", depends = ["bun"], minimum_release_age = "0", postinstall = \'cd "$MISE_TOOL_INSTALL_PATH" && "${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs/bun/latest/bin/bun" pm trust @ampcode/cli && ln -sfn "$MISE_TOOL_INSTALL_PATH" "$(dirname "$MISE_TOOL_INSTALL_PATH")/latest"\' }',
    ),
}
DCG_MISE_NAME = "github:Dicklesworthstone/destructive_command_guard"
MARKER = "# Generated by configure-ai-tools."
ALL = tuple(TOOLS)
OMP_PROFILES = {"claude", "codex", "codex-claude", "copilot", "or", "or-cheap", "personal"}
OMP_CONFIG_HEADER = "# Generated by omp-profile from ai/omp/"

def selected_tools() -> tuple[str, ...]:
    dotfiles = Path(
        os.environ.get("DOTFILES", Path(__file__).resolve().parents[2])
    ).resolve()
    completed = subprocess.run(
        [str(dotfiles / "ai/.bin/ai-tool-enabled"), "--list"],
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode:
        raise SystemExit(completed.stderr.strip())
    return tuple(completed.stdout.splitlines())


def previous_tools(path: Path) -> tuple[str, ...]:
    if path.is_symlink():
        raise SystemExit(f"Refusing to overwrite linked AI tool state: {path}")
    if not path.exists():
        return ()
    if path.read_text().splitlines()[:1] != [MARKER]:
        raise SystemExit(f"Refusing to overwrite unmanaged AI tool state: {path}")
    for line in path.read_text().splitlines():
        metadata = line.removeprefix("# ")
        if metadata.startswith("DOTFILES_AI_TOOLS="):
            value = metadata.partition("=")[2]
            return tuple(item for item in value.split(",") if item)
    raise SystemExit(f"Managed AI tool state is missing selection metadata: {path}")


def mise_name(tool: str) -> str:
    return TOOLS[tool][0].strip('"')


def write_atomic(path: Path, text: str) -> None:
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(text)
    temporary.replace(path)


def trash(path: Path) -> None:
    subprocess.run(["trash", str(path)], check=True)


def remove_if_managed(path: Path, dotfiles: Path) -> None:
    if not path.is_symlink():
        return
    try:
        path.resolve().relative_to(dotfiles)
    except (OSError, ValueError):
        return
    trash(path)


def remove_empty_directories(*paths: Path) -> None:
    for path in paths:
        try:
            path.rmdir()
        except OSError:
            pass


def retire_dcg_guard(guard: Path) -> None:
    """Remove a retired harness guard only when install-dcg-guards recorded it."""
    state = Path.home() / ".local/state/dotfiles/dcg-guards.json"
    if not state.is_file() or state.is_symlink():
        return
    try:
        ownership = json.loads(state.read_text())
    except (OSError, json.JSONDecodeError):
        return
    if (
        isinstance(ownership, dict)
        and ownership.get("marker") == "Generated by install-dcg-guards."
        and isinstance(ownership.get("guards"), list)
        and str(guard) in ownership["guards"]
    ):
        if guard.is_file() and not guard.is_symlink():
            trash(guard)
        ownership["guards"] = [item for item in ownership["guards"] if item != str(guard)]
        write_atomic(state, json.dumps(ownership, indent=2) + "\n")


def remove_managed_links(selected: set[str]) -> None:
    home = Path.home()
    dotfiles = Path(
        os.environ.get("DOTFILES", Path(__file__).resolve().parents[2])
    ).resolve()
    destinations = {
        "claude": [
            home / ".claude/CLAUDE.md",
            home / ".claude/statusline-command.sh",
            home / ".claude/keybindings.json",
            home / ".claude/skills",
        ],
        "pi": [
            home / ".pi/agent/AGENTS.md",
            home / ".pi/agent/models.json",
            home / ".pi/agent/keybindings.json",
            home / ".pi/agent/lsp.json",
            home / ".pi/agent/extensions/subagent/config.json",
        ],
        "codex": [home / ".codex/AGENTS.md"],
        "amp": [home / ".config/amp/settings.json", home / ".config/amp/AGENTS.md"],
    }

    for tool, paths in destinations.items():
        if tool in selected:
            continue
        for path in paths:
            remove_if_managed(path, dotfiles)

    if "claude" not in selected:
        for path in (home / ".claude/skills").glob("*"):
            remove_if_managed(path, dotfiles)
    if not selected.intersection({"pi", "codex"}):
        for path in (home / ".agents/skills").glob("*"):
            remove_if_managed(path, dotfiles)


def retire_omp(previous: tuple[str, ...]) -> None:
    home = Path.home()
    dotfiles = Path(os.environ.get("DOTFILES", Path(__file__).resolve().parents[2])).resolve()
    agent = home / ".omp/agent"
    shared_links = ("AGENTS.md", "models.yml", "keybindings.yml", "mcp.json", "WATCHDOG.md")

    if "omp" in previous and (herdr := shutil.which("herdr")):
        subprocess.run([herdr, "integration", "uninstall", "omp"], check=True)

    for path in (
        home / ".bin/omp-profile",
        *(agent / name for name in shared_links),
        agent / "config.yml",
        agent / ".active",
        agent / "skills",
        agent / "extensions/dcg-guard.ts",
    ):
        remove_if_managed(path, dotfiles)
    shortcut = home / ".local/bin/omp"
    if shortcut.is_symlink() and shortcut.readlink() == home / ".local/share/mise/shims/omp":
        trash(shortcut)
    retire_dcg_guard(agent / "extensions/dcg-guard.ts")

    # OMP rewrote config.yml without the generated header, so a selected
    # dotfiles profile in .active is also proof that omp-profile owns it.
    active = agent / ".active"
    active_managed = (
        active.is_file() and not active.is_symlink() and active.read_text().strip() in OMP_PROFILES
    )
    config = agent / "config.yml"
    if config.is_file() and not config.is_symlink() and (
        active_managed or config.read_text().startswith(OMP_CONFIG_HEADER)
    ):
        trash(config)
    if active_managed:
        trash(active)

    profiles = home / ".omp/profiles"
    for name in sorted(OMP_PROFILES):
        profile = profiles / name
        profile_agent = profile / "agent"
        if any(path.is_symlink() for path in (profiles, profile, profile_agent)):
            continue
        for link in shared_links:
            remove_if_managed(profile_agent / link, dotfiles)
        agents = profile_agent / "agents"
        if agents.is_symlink() and agents.readlink() == agent / "agents":
            trash(agents)
        profile_config = profile_agent / "config.yml"
        if (
            profile_config.is_file()
            and not profile_config.is_symlink()
            and profile_config.read_text().startswith(OMP_CONFIG_HEADER)
        ):
            trash(profile_config)
        remove_empty_directories(profile_agent, profile)
    remove_empty_directories(profiles, agent / "extensions")


def retire_opencode(previous: tuple[str, ...]) -> None:
    home = Path.home()
    dotfiles = Path(os.environ.get("DOTFILES", Path(__file__).resolve().parents[2])).resolve()
    managed_links = {
        home / ".bin/opencode-profile": dotfiles / "ai/.bin/opencode-profile",
        home / ".config/opencode/AGENTS.md": dotfiles / "ai/AGENTS.md",
        home / ".config/opencode/tui.jsonc": dotfiles / "ai/opencode/tui.jsonc",
    }
    for path, source in managed_links.items():
        if path.is_symlink() and path.resolve() == source:
            trash(path)
    legacy_profiles = dotfiles / "ai/opencode/registry/files/profiles"
    for path in (home / ".config/opencode/profiles").glob("*"):
        if path.is_symlink():
            try:
                path.resolve().relative_to(legacy_profiles)
            except (OSError, ValueError):
                continue
            trash(path)

    config = home / ".config/opencode/opencode.jsonc"
    if config.is_file() and not config.is_symlink() and config.read_text().startswith(
        "// Generated by opencode-profile from ai/opencode/"
    ):
        trash(config)
        active = home / ".config/opencode/.active"
        if active.is_file() and not active.is_symlink() and active.read_text().strip() in {
            "gpt", "claude", "claude-gpt", "or", "or-cheap", "copilot"
        }:
            trash(active)

    retire_dcg_guard(home / ".config/opencode/plugins/dcg-guard.js")

    if "opencode" in previous and (herdr := shutil.which("herdr")):
        subprocess.run([herdr, "integration", "uninstall", "opencode"], check=True)


def main() -> int:
    selected = selected_tools()
    selected_set = set(selected)
    config = Path.home() / ".config/mise/conf.d/40-ai.toml"
    state = Path.home() / ".local/state/dotfiles/ai-tools"
    config.parent.mkdir(parents=True, exist_ok=True)
    if config.is_symlink():
        raise SystemExit(f"Refusing to overwrite linked AI Mise config: {config}")
    if config.exists() and config.read_text().splitlines()[:1] != [MARKER]:
        raise SystemExit(f"Refusing to overwrite unmanaged AI Mise config: {config}")
    previous_path = state if state.exists() or state.is_symlink() else config
    previous = previous_tools(previous_path)

    lines = [MARKER, f"# DOTFILES_AI_TOOLS={','.join(selected)}", "", "[tools]"]
    if selected:
        lines.append(f'"{DCG_MISE_NAME}" = "latest"')
    if "amp" in selected:
        lines.append('bun = "latest"')
    for tool in selected:
        key, value = TOOLS[tool]
        lines.append(f"{key} = {value}")
    write_atomic(config, "\n".join(lines) + "\n")
    remove_managed_links(selected_set)
    retire_omp(previous)
    retire_opencode(previous)

    mise = os.environ.get("MISE_BIN") or shutil.which("mise")
    if not mise:
        print(
            "mise not on PATH; wrote AI tool configuration without installing packages"
        )
        return 0

    deselected = [
        tool for tool in previous if tool in TOOLS and tool not in selected_set
    ]
    # Retire packages from older selections as well as current tools.
    uninstall = [mise_name(tool) for tool in deselected]
    if "opencode" in previous:
        uninstall.append("opencode")
    if "omp" in previous:
        uninstall.append("github:can1357/oh-my-pi")
    if uninstall:
        subprocess.run([mise, "uninstall", "--all", "--yes", *uninstall], check=True)
    if "opencode" in previous:
        shim = Path.home() / ".local/share/mise/shims/opencode"
        if shim.is_symlink() and shim.resolve() == Path(mise).resolve():
            trash(shim)
    if selected:
        install = [DCG_MISE_NAME, *[mise_name(tool) for tool in selected]]
        subprocess.run([mise, "install", "--yes", *install], check=True)
    state.parent.mkdir(parents=True, exist_ok=True)
    write_atomic(state, f"{MARKER}\nDOTFILES_AI_TOOLS={','.join(selected)}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
