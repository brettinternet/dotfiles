#!/bin/sh
# opencode-profile — manage OpenCode config profile overlays
# Usage: opencode-profile [show|list|use <name>|config|path [<name>|common]|edit [<name>|common]|new <name> [--from <other>]]
set -eu

# Resolve dotfiles root: $DOTFILES env, or walk up from this script's realpath.
# The script is typically invoked via a symlink (dotbot), so resolve symlinks
# on $0 before walking up — otherwise we'd land in the symlink's dir.
if [ -z "${DOTFILES:-}" ]; then
  _src="$0"
  while [ -L "$_src" ]; do
    _dir="$(cd "$(dirname "$_src")" && pwd -P)"
    _src="$(readlink "$_src")"
    case "$_src" in
      /*) ;;
      *) _src="$_dir/$_src" ;;
    esac
  done
  _self="$(cd "$(dirname "$_src")" && pwd -P)"
  DOTFILES="$(cd "$_self/../.." && pwd -P)"
fi

PROFILES_DIR="$DOTFILES/ai/opencode/profiles"
COMMON_PROFILE="$PROFILES_DIR/common.jsonc"
CONFIG_FILE="$DOTFILES/ai/opencode/opencode.jsonc"
ACTIVE_FILE="$DOTFILES/ai/opencode/.active"
MERGE_PROFILE="$DOTFILES/ai/opencode/merge-profile.py"
DEFAULT_PROFILE="gpt"

die() { printf '%s\n' "$*" >&2; exit 1; }

profile_path() {
  case "$1" in
    common) printf '%s\n' "$COMMON_PROFILE" ;;
    *)      printf '%s/%s.jsonc\n' "$PROFILES_DIR" "$1" ;;
  esac
}

active_profile() {
  if [ -f "$ACTIVE_FILE" ]; then
    cat "$ACTIVE_FILE"
  else
    printf '%s\n' "$DEFAULT_PROFILE"
  fi
}

cmd_show() {
  profile="$(active_profile)"
  printf '%s\t%s\n' "$profile" "$(profile_path "$profile")"
}

cmd_list() {
  active="$(active_profile)"
  for f in "$PROFILES_DIR"/*.jsonc; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .jsonc)"
    [ "$name" = common ] && continue
    if [ "$name" = "$active" ]; then
      printf '* %s\n' "$name"
    else
      printf '  %s\n' "$name"
    fi
  done
}

render_config() {
  name="$1"
  [ "$name" != common ] || die "opencode-profile: 'common' is a shared base, not a selectable profile"
  target="$(profile_path "$name")"
  [ -f "$COMMON_PROFILE" ] || die "opencode-profile: common profile not found ($COMMON_PROFILE)"
  [ -f "$target" ] || die "opencode-profile: profile '$name' not found ($target)"
  [ -f "$MERGE_PROFILE" ] || die "opencode-profile: merge helper not found ($MERGE_PROFILE)"

  tmp="${CONFIG_FILE}.tmp.$$"
  if python3 "$MERGE_PROFILE" "$COMMON_PROFILE" "$target" "$tmp"; then
    mv "$tmp" "$CONFIG_FILE"
  else
    [ ! -e "$tmp" ] || unlink "$tmp"
    return 1
  fi
}

cmd_use() {
  name="${1:-}"
  [ -n "$name" ] || die "usage: opencode-profile use <name>"
  render_config "$name"
  printf '%s\n' "$name" > "$ACTIVE_FILE"
  printf 'switched to %s\n' "$name"
}

cmd_path() {
  name="${1:-$(active_profile)}"
  target="$(profile_path "$name")"
  [ -f "$target" ] || die "opencode-profile: profile '$name' not found ($target)"
  printf '%s\n' "$target"
}

cmd_config() {
  [ $# -eq 0 ] || die "usage: opencode-profile config"
  printf '%s\n' "$CONFIG_FILE"
}

cmd_edit() {
  name="${1:-$(active_profile)}"
  target="$(profile_path "$name")"
  [ -f "$target" ] || die "opencode-profile: profile '$name' not found ($target)"
  "${EDITOR:-vi}" "$target"
}

cmd_new() {
  name="${1:-}"
  [ -n "$name" ] || die "usage: opencode-profile new <name> [--from <other>]"
  shift
  from="$(active_profile)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ $# -gt 1 ] || die "usage: opencode-profile new <name> [--from <other>]"; from="$2"; shift 2 ;;
      *) die "opencode-profile new: unknown option '$1'" ;;
    esac
  done
  [ "$from" != common ] || die "opencode-profile: 'common' is a shared base, not a profile template"
  src="$(profile_path "$from")"
  dst="$PROFILES_DIR/$name.jsonc"
  [ -f "$src" ] || die "opencode-profile: source profile '$from' not found ($src)"
  [ ! -e "$dst" ] || die "opencode-profile: profile '$name' already exists ($dst)"
  cp "$src" "$dst"
  printf 'created %s\n' "$dst"
}

usage() {
  cat <<EOF
usage: opencode-profile [show]             print active profile and source profile path
       opencode-profile list               list selectable profiles (active marked with *)
       opencode-profile use <name>         generate config from common + profile <name>
       opencode-profile config             print generated active config path
       opencode-profile path [<name>|common]  print source profile path (default: active)
       opencode-profile edit [<name>|common]  open source profile in \$EDITOR (default: active)
       opencode-profile new <name> [--from <other>]  create a profile overlay (copy from another overlay)
       opencode-profile -h|--help          show this help
EOF
}

case "${1:-show}" in
  show)
    if [ "$#" -gt 0 ]; then shift; fi
    cmd_show "$@"
    ;;
  list)       shift; cmd_list "$@" ;;
  use)        shift; cmd_use "$@" ;;
  path)       shift; cmd_path "$@" ;;
  config)     shift; cmd_config "$@" ;;
  edit)       shift; cmd_edit "$@" ;;
  new)        shift; cmd_new "$@" ;;
  -h|--help)  usage ;;
  *)          die "opencode-profile: unknown command '${1}'. Try: opencode-profile --help" ;;
esac
