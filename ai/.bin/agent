#!/usr/bin/env python3
# Stateless named launches for Pi, Claude Code, and Codex; installed by make ai.
# Examples:
#   agent alice                              # Pi in this terminal
#   agent bob -k claude -- 'Review this diff' # Claude Code with a prompt
#   agent carol -k codex -- resume            # Codex session picker
#   agent alice -s down                       # new split below the calling pane
#   agent alice -t review -f                  # fresh tab, focused
#   agent alice -w maintenance -t review      # reuse workspace by label + cwd
#   agent alice -w maintenance -t review --reuse-tab
#                                            # add a split in the matching tab
#   agent alice -w maintenance -t review --reuse-pane
#                                            # replace alice there; terminates old agent
#   agent reviewer --herdr-session default -w maintenance -C ~/dev/me/maintenance
#                                            # launch outside Herdr in an explicit session
#   agent alice -w maintenance -t review --reuse-pane -n
#                                            # preview only; does not contact Herdr
#   agent --list                             # list live agents and their locations
#   agent --status alice                     # inspect alice's current status as JSON
#   agent alice -t --close-on-done -- 'Review this diff'
#                                            # watch working -> done, then close; Ctrl-C cancels
#   agent alice -t --wait -- 'Review this diff'
#                                            # block until exit; SIGTERM closes it, Ctrl-C detaches
#   herdr agent wait alice --until done      # wait for done (not proof the task succeeded)
#   agent --close alice                      # close the exact live name's pane
#   agent --close alice --herdr-session default
#                                            # close in an explicit session
# Reuse flags are opt-in; --reuse-pane implies --reuse-tab. Pane IDs change on replacement.
# See `agent --help` and ai/README.md.
"""Launch a named coding agent locally or in Herdr, or close it by live name."""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "base/lib"))
from herdr_launch import herdr_client, placed_pane

KINDS = ("pi", "claude", "codex")
LIVE_NAME = re.compile(r"[a-z][a-z0-9_-]{0,31}")
DEFAULT_STARTUP_TIMEOUT = 30

EXAMPLES = """\
examples:
  agent alice                            Pi in this terminal
  agent bob -k claude                    Claude Code in this terminal
  agent carol -k codex -- resume         Codex's session picker
  agent alice -- --session-id alice      create or reopen this Pi conversation
  agent alice -s                         split the calling Herdr pane (right)
  agent alice -s down -T "Dependency PRs"
  agent "Auth review" -t                 fresh tab titled "Auth review", live name auth-review
  agent alice -w maintenance -t review   tab in the "maintenance" workspace for this checkout

  # Scheduled launch, including outside Herdr; copies exported APPRISE_URLS
  agent reviewer --herdr-session default -w maintenance -C ~/dev/me/maintenance \\
    -e APPRISE_URLS -- 'Review open PRs'

Native agent arguments go after --. A name is a label, not automatic resume.
Without -w, -t, or -s the agent runs in this terminal. Herdr placement defaults to fresh tabs/panes, preserves focus unless -f,
and prints agent-start JSON. --reuse-tab adds a split to a matching tab;
--reuse-pane implies --reuse-tab and replaces the exact named agent there.
agent --close NAME closes the pane hosting that exact live Herdr name. The
Herdr live name is derived from NAME and gets a numeric suffix if taken; an
explicit --herdr-name fails on collision unless replacing with --reuse-pane.
On failure, inspect the
retained pane before retrying: a timeout does not prove the agent never started."""


def arguments() -> tuple[argparse.Namespace, list[str]]:
    parser = argparse.ArgumentParser(
        description=__doc__, epilog=EXAMPLES, allow_abbrev=False,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("name", nargs="?", metavar="NAME", help="display name, or exact live name with --close")
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--close", action="store_true", help="close the pane hosting NAME (terminates its processes)")
    action.add_argument("--list", action="store_true", help="list live agents and their locations as Herdr JSON")
    action.add_argument("--status", action="store_true", help="show the exact live NAME's status as Herdr JSON")
    parser.add_argument("-k", "--kind", choices=KINDS, default="pi", help="agent CLI (default: pi)")
    parser.add_argument("-C", "--cwd", type=Path, default=Path.cwd(), metavar="DIR",
                        help="working directory (default: current)")
    parser.add_argument("-e", "--env", action="append", default=[], metavar="KEY[=VALUE]",
                        help="set a child variable, or copy an exported one; repeatable")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="print a JSON plan without launching or contacting Herdr; env values redacted")
    herdr = parser.add_argument_group("Herdr placement")
    herdr.add_argument("-s", "--split", nargs="?", const="right", choices=("right", "down"),
                       help="split the calling pane (default direction: right)")
    herdr.add_argument("-t", "--tab", nargs="?", const="", metavar="TITLE",
                       help="fresh tab in the caller's or -w workspace (title defaults to NAME)")
    herdr.add_argument("-w", "--workspace", metavar="LABEL",
                       help="workspace label, matched with the checkout; created if absent")
    herdr.add_argument("--reuse-tab", action="store_true", help="reuse the first matching tab title; add a split")
    herdr.add_argument("--reuse-pane", action="store_true",
                       help="replace the exact named agent in the selected tab; implies --reuse-tab")
    herdr.add_argument("-T", "--pane-title", metavar="TITLE", help="label the created pane")
    herdr.add_argument("-f", "--focus", action="store_true", help="focus the created pane")
    parser.add_argument("--wait", action="store_true",
                        help="wait for the launched agent process to exit, regardless of lifecycle status; "
                             "SIGTERM closes the agent's pane")
    herdr.add_argument("--close-on-done", action="store_true",
                       help="stay running; close after observing working then done; cancel on blocked/unknown")
    herdr.add_argument("--startup-timeout", type=int, metavar="SECONDS",
                       help=f"wait for interactive readiness, 1-300 (default: {DEFAULT_STARTUP_TIMEOUT})")
    herdr.add_argument("--herdr-session", metavar="SESSION",
                       help="explicit Herdr session, usable outside Herdr; requires -w")
    herdr.add_argument("--herdr-name", metavar="NAME",
                       help="exact live Herdr name; fails if taken unless --reuse-pane (default: derived from NAME)")

    raw = sys.argv[1:]
    boundary = raw.index("--") if "--" in raw else len(raw)
    args = parser.parse_args(raw[:boundary])
    native = raw[boundary + 1:]

    if not args.list and args.name is None:
        parser.error("NAME is required unless --list is used")
    if args.list and args.name is not None:
        parser.error("--list does not accept NAME")
    if args.close or args.list or args.status:
        operation = "--close" if args.close else "--status" if args.status else "--list"
        allowed = {operation, "--herdr-session", "-n", "--dry-run", "-C", "--cwd"}
        supplied = {word.split("=", 1)[0] for word in raw[:boundary] if word.startswith("-")}
        if supplied - allowed or native:
            parser.error(f"{operation} accepts only --herdr-session, --dry-run, --cwd, and NAME except for --list")
        if not args.list and not LIVE_NAME.fullmatch(args.name):
            parser.error(f"NAME must match {LIVE_NAME.pattern}")
        if args.herdr_session is None and os.environ.get("HERDR_ENV") != "1":
            parser.error(f"{operation} requires running inside Herdr or --herdr-session")
        if args.herdr_session is not None and not args.herdr_session.strip():
            parser.error("Herdr session must not be blank")
        return args, native

    args.reuse_tab = args.reuse_tab or args.reuse_pane
    if args.reuse_tab and (args.split or (args.workspace is None and args.tab is None)):
        parser.error("reuse requires --workspace or --tab, and cannot be combined with --split")
    args.cwd = args.cwd.expanduser().resolve()
    if not args.cwd.is_dir():
        parser.error("--cwd must be an existing directory")
    if not args.name.strip():
        parser.error("NAME must not be blank")
    args.herdr = any(value is not None for value in (args.workspace, args.tab, args.split))
    if not args.herdr:
        if args.focus or args.close_on_done or any(value is not None for value in
                             (args.herdr_name, args.herdr_session, args.pane_title, args.startup_timeout)):
            parser.error("Herdr options require --workspace, --tab, or --split")
        return args, native
    if args.split and (args.workspace is not None or args.tab is not None or args.herdr_session is not None):
        parser.error("--split cannot be combined with --workspace, --tab, or --herdr-session")
    if args.herdr_session is not None and args.workspace is None:
        parser.error("--herdr-session requires --workspace; never use another session's focused workspace")
    if args.startup_timeout is not None and not 1 <= args.startup_timeout <= 300:
        parser.error("--startup-timeout must be between 1 and 300 seconds")
    if any(value is not None and not value.strip() for value in (args.workspace, args.herdr_session, args.pane_title)):
        parser.error("Herdr session, workspace, and pane titles must not be blank")
    if args.tab and not args.tab.strip():
        parser.error("--tab title must not be blank")
    if args.pane_title == "--clear":
        parser.error("--pane-title cannot be --clear; Herdr reads it as a flag")
    if args.herdr_name is not None and not LIVE_NAME.fullmatch(args.herdr_name):
        parser.error(f"--herdr-name must match {LIVE_NAME.pattern}")
    if args.herdr_session is None and os.environ.get("HERDR_ENV") != "1":
        parser.error("Herdr placement requires running inside Herdr or --herdr-session")
    if args.split and not os.environ.get("HERDR_PANE_ID"):
        parser.error("--split requires the calling HERDR_PANE_ID")
    if args.workspace is None and not args.split and not os.environ.get("HERDR_WORKSPACE_ID"):
        parser.error("--tab requires the calling HERDR_WORKSPACE_ID or --workspace")
    if not args.split:
        args.tab = args.tab or args.name
    return args, native


def live_name(display: str) -> str:
    """Derive a valid Herdr live name: "Auth review" -> "auth-review"."""
    slug = re.sub(r"[^a-z0-9_-]+", "-", display.lower()).strip("-_")
    if not slug[:1].isalpha():
        slug = f"agent-{slug}"
    return slug[:32].rstrip("-_")


def unique_name(base: str, taken: set[str]) -> str:
    name, number = base, 1
    while name in taken:
        number += 1
        suffix = f"-{number}"
        name = base[:32 - len(suffix)].rstrip("-_") + suffix
    return name


def child_variables(specifications: list[str], name: str) -> dict[str, str]:
    variables = {}
    for specification in specifications:
        key, separator, value = specification.partition("=")
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            raise ValueError(f"--env {key!r}: invalid environment variable name")
        if key == "AGENT_NAME" or key.startswith("HERDR_"):
            raise ValueError("--env cannot override AGENT_NAME or Herdr routing variables")
        if not separator:
            if key not in os.environ:
                raise ValueError(f"--env {key}: variable is not exported")
            value = os.environ[key]
        variables[key] = value
    variables["AGENT_NAME"] = name
    return variables


def preview(args: argparse.Namespace, native: list[str], variables: dict[str, str]) -> None:
    placement = None
    if args.herdr:
        placement = {
            "session": args.herdr_session or "inherited",
            "name": args.herdr_name or live_name(args.name),
            "on_name_collision": ("replace in selected tab; fail elsewhere" if args.reuse_pane else
                                  "fail" if args.herdr_name else "add numeric suffix"),
            "workspace_label": args.workspace,
            "caller_workspace_id": os.environ.get("HERDR_WORKSPACE_ID") if args.workspace is None else None,
            "tab_title": args.tab,
            "reuse_tab": args.reuse_tab,
            "reuse_pane": args.reuse_pane,
            "split": args.split,
            "caller_pane_id": os.environ.get("HERDR_PANE_ID") if args.split else None,
            "pane_title": args.pane_title,
            "focus": args.focus,
            "startup_timeout_seconds": args.startup_timeout or DEFAULT_STARTUP_TIMEOUT,
            "wait": args.wait,
            "close_on_done": args.close_on_done,
        }
    print(json.dumps({
        "dry_run": True,
        "cwd": str(args.cwd),
        "argv": [args.kind, *native],
        "env": {key: "<redacted>" for key in variables},
        "herdr": placement,
    }, indent=2))


def close_agent(args: argparse.Namespace) -> None:
    if args.dry_run:
        print(json.dumps({"dry_run": True, "close": args.name, "session": args.herdr_session or "inherited"}))
        return
    h = herdr_client(args)
    matches = [agent for agent in h("agent", "list")["result"]["agents"] if agent.get("name") == args.name]
    if not matches:
        print(json.dumps({"result": {"name": args.name, "closed": False, "reason": "not_found"}}))
        return
    if len(matches) > 1:
        raise ValueError("Multiple agents have that live name; refusing to close")
    print(json.dumps(h("pane", "close", matches[0]["pane_id"])))


def process_identity(pid: int) -> tuple[int, str] | None:
    """Pin process birth as well as PID; stopped processes are still alive."""
    result = subprocess.run(["ps", "-p", str(pid), "-o", "ppid=", "-o", "lstart=", "-o", "stat="],
                            capture_output=True, text=True)
    if result.returncode == 1 and not result.stdout.strip() and not result.stderr.strip():
        return None
    if result.returncode:
        raise RuntimeError("Cannot inspect launched agent process; wait cancelled")
    fields = result.stdout.strip().rsplit(None, 1)
    if len(fields) != 2:
        raise ValueError("Invalid agent process information; wait cancelled")
    parent, birth = fields[0].split(None, 1)
    return None if fields[1].startswith("Z") else (int(parent), birth)


def watch_agent(h, pane: str, name: str, started: dict, *, wait: bool, close: bool) -> None:
    """Process waiting and optional, conservative turn cleanup are separate policies."""
    pid = birth = None
    if wait:
        info = h("pane", "process-info", "--pane", pane)["result"]["process_info"]
        pid = info["foreground_process_group_id"]
        if (not isinstance(pid, int) or pid <= 0 or pid == info["shell_pid"]
                or not any(item.get("pid") == pid for item in info["foreground_processes"])):
            raise ValueError("Cannot establish launched agent process; wait cancelled")
        # A pager/tool can own the foreground group. Follow ancestry to the
        # original shell child rather than mistaking that tool's exit for the agent's.
        seen = set()
        while pid not in seen:
            seen.add(pid)
            process = process_identity(pid)
            if process is None:
                raise ValueError("Agent exited during process identification; exit status unavailable")
            parent, birth = process
            if parent == info["shell_pid"]:
                break
            if parent <= 1 or parent == pid:
                raise ValueError("Cannot establish agent ancestry; wait cancelled")
            pid = parent
        else:
            raise ValueError("Invalid agent process ancestry; wait cancelled")
        command = subprocess.run(["ps", "-p", str(pid), "-o", "args="], capture_output=True, text=True)
        if (command.returncode or not command.stdout.split()
                or Path(command.stdout.split()[0]).name != started.get("agent")):
            raise ValueError("Foreground process is not the launched agent; wait cancelled")
        checked = h("agent", "get", pane)["result"]["agent"]
        if any(checked.get(key) != started.get(key) for key in
               ("terminal_id", "name", "agent", "agent_session")):
            raise ValueError("Agent changed during process identification; wait cancelled")
    identity_keys = ("pane_id", "terminal_id", "name", "agent", "agent_session")
    identity = {key: started.get(key) for key in identity_keys}
    if close and (identity["pane_id"] != pane or identity["name"] != name or not all(identity.values())):
        if not wait:
            raise ValueError("Cannot establish launched agent identity; wait cancelled")
        close = False
        print("agent: auto-close cancelled (incomplete identity); still waiting for process exit", file=sys.stderr)
    working = False
    current = started
    while True:
        if wait:
            process = process_identity(pid)
            if process is None or process[1] != birth:
                print(json.dumps({"result": {"pane_id": pane, "name": name, "exited": True,
                                             "exit_code": None}}), flush=True)
                return
        if not close:
            time.sleep(0.5)
            continue
        try:
            if current is None:
                current = h("agent", "get", pane)["result"]["agent"]
            if any(current.get(key) != value for key, value in identity.items()):
                raise ValueError("Agent identity changed; wait cancelled")
            if not isinstance(current.get("state_change_seq"), int):
                raise ValueError("Agent state sequence is unavailable; wait cancelled")
            status = current.get("agent_status")
            if status not in ("idle", "working", "done"):
                raise ValueError("Agent is blocked or its state is unknown; wait cancelled")
            if status == "working":
                working = True
            elif status == "done" and working:
                # Re-read before accepting completion or closing. Pane IDs are never reused.
                checked = h("agent", "get", pane)["result"]["agent"]
                if (any(checked.get(key) != value for key, value in identity.items())
                        or checked.get("agent_status") != "done"
                        or checked.get("state_change_seq") != current.get("state_change_seq")):
                    raise ValueError("Agent changed before completion; wait cancelled")
                print(json.dumps(h("pane", "close", pane)), flush=True)
                if wait:
                    close = False
                    continue
                return
        except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
            if not wait:
                raise
            # A failed closing policy must not abandon an independent lifetime wait.
            close = False
            process = process_identity(pid)
            if process is not None and process[1] == birth:
                print(f"agent: auto-close cancelled ({error}); still waiting for process exit", file=sys.stderr)
            continue  # Natural exit can also race any lifecycle query or close.
        time.sleep(0.5)
        current = None


def stop_agent(h, pane: str, started: dict) -> bool:
    """Close the pane only while it still hosts the exact launched agent."""
    signal.signal(signal.SIGTERM, signal.SIG_IGN)  # A repeated SIGTERM must not abandon the close.
    keys = ("pane_id", "terminal_id", "name", "agent", "agent_session")
    try:
        current = h("agent", "get", pane)["result"]["agent"]
        if started.get("pane_id") != pane or any(not started.get(key) or current.get(key) != started.get(key)
                                                  for key in keys):
            raise ValueError("agent identity changed")
        print(json.dumps(h("pane", "close", pane)), flush=True)
        return True
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
        print(f"agent: stop not applied ({error})", file=sys.stderr)
        return False


def launch_herdr(args: argparse.Namespace, native: list[str], variables: dict[str, str]) -> None:
    h = herdr_client(args)
    # Resolve the live name before making layout. Herdr also enforces uniqueness at start.
    agents = h("agent", "list")["result"]["agents"]
    taken = {agent.get("name") for agent in agents}
    if args.herdr_name is not None:
        if args.herdr_name in taken and not args.reuse_pane:
            raise ValueError(f"Herdr agent {args.herdr_name!r} already exists; omit --herdr-name or choose another")
        name = args.herdr_name
    else:
        name = live_name(args.name) if args.reuse_pane else unique_name(live_name(args.name), taken)

    old = [agent for agent in agents if agent.get("name") == name] if args.reuse_pane else []
    if len(old) > 1:
        raise ValueError("Multiple agents have that live name; refusing to replace")
    replacement = old[0]["pane_id"] if old else None
    stopped = False
    with placed_pane(h, args, variables, replacement=replacement) as pane:
        timeout = ["--timeout", str(args.startup_timeout * 1000)] if args.startup_timeout else []
        result = h("agent", "start", name, "--kind", args.kind, "--pane", pane, *timeout, "--", *native)
        print(json.dumps(result), flush=True)
        if args.wait or args.close_on_done:
            try:
                watch_agent(h, pane, name, result["result"]["agent"], wait=args.wait, close=args.close_on_done)
            except SystemExit as stop:
                # A supervisor's SIGTERM stops the work it waits on; Ctrl-C only detaches.
                if not (args.wait and stop.code == 143 and stop_agent(h, pane, result["result"]["agent"])):
                    raise
                stopped = True
    if stopped:
        raise SystemExit(143)


def main() -> int:
    args, native = arguments()
    try:
        if args.status:
            if args.dry_run:
                print(json.dumps({"dry_run": True, "status": args.name, "session": args.herdr_session or "inherited"}))
            else:
                print(json.dumps(herdr_client(args)("agent", "get", args.name)))
            return 0
        if args.list:
            if args.dry_run:
                print(json.dumps({"dry_run": True, "list": True, "session": args.herdr_session or "inherited"}))
            else:
                print(json.dumps(herdr_client(args)("agent", "list")))
            return 0
        if args.close:
            close_agent(args)
            return 0
        variables = child_variables(args.env, args.name)
        if args.kind != "codex":  # Codex has no native --name; it gets AGENT_NAME only
            native = ["--name", args.name, *native]
        if args.dry_run:
            preview(args, native, variables)
        elif args.herdr:
            if args.wait or args.close_on_done:
                signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
            launch_herdr(args, native, variables)
        else:
            os.chdir(args.cwd)
            try:
                os.execvpe(args.kind, [args.kind, *native], {**os.environ, **variables})
            except FileNotFoundError:
                raise FileNotFoundError(f"{args.kind}: command not found") from None
        return 0
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
        print(f"agent: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
