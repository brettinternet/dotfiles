#!/usr/bin/env python3
"""Remove resources managed by ai.yaml while preserving unrelated user state."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

DOTFILES = Path(
    os.environ.get("DOTFILES", Path(__file__).resolve().parents[2])
).resolve()
HOME = Path.home()
GENERATED_MARKER = "# Generated by configure-ai-tools."


def run(*arguments: str, check: bool = True) -> None:
    environment = {**os.environ, "DOTFILES": str(DOTFILES), "DOTFILES_AI_TOOLS": "none"}
    subprocess.run(arguments, env=environment, check=check)


def trash_managed(path: Path) -> None:
    if path.exists() or path.is_symlink():
        subprocess.run(["trash", str(path)], check=True)


def remove_dotfiles_link(path: Path) -> None:
    if not path.is_symlink():
        return
    try:
        path.resolve().relative_to(DOTFILES)
    except (OSError, ValueError):
        return
    trash_managed(path)


def remove_generated_file(path: Path, marker: str) -> None:
    if (
        path.is_file()
        and not path.is_symlink()
        and path.read_text().splitlines()[:1] == [marker]
    ):
        trash_managed(path)


def remove_dcg_hooks(path: Path, managed_command: str) -> None:
    if not path.is_file() or path.is_symlink():
        return
    try:
        data = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return
    if not isinstance(data, dict):
        return
    hooks = data.get("hooks")
    if not isinstance(hooks, dict):
        return
    entries = hooks.get("PreToolUse")
    if not isinstance(entries, list):
        return

    changed = False
    retained: list[Any] = []
    for entry in entries:
        if not isinstance(entry, dict) or not isinstance(entry.get("hooks"), list):
            retained.append(entry)
            continue
        handlers = []
        for handler in entry["hooks"]:
            command = handler.get("command") if isinstance(handler, dict) else None
            if command == managed_command:
                changed = True
            else:
                handlers.append(handler)
        if handlers:
            retained.append({**entry, "hooks": handlers})
        elif entry["hooks"]:
            changed = True
    if not changed:
        return
    if retained:
        hooks["PreToolUse"] = retained
    else:
        hooks.pop("PreToolUse", None)
    if not hooks:
        data.pop("hooks", None)
    path.write_text(json.dumps(data, indent=2) + "\n")


def remove_profile(
    config: Path,
    active: Path,
    profiles: Path,
    *,
    marker: str | None = None,
    proof: tuple[Path, Path] | None = None,
    extra: tuple[Path, ...] = (),
) -> None:
    active_managed = False
    if active.is_file() and not active.is_symlink():
        name = active.read_text().strip()
        active_managed = bool(
            name
            and name != "common"
            and any(
                (profiles / f"{name}{suffix}").is_file()
                for suffix in (".json", ".jsonc", ".yml")
            )
        )
    marker_matches = bool(
        marker
        and config.is_file()
        and not config.is_symlink()
        and config.read_text().startswith(marker)
    )
    proof_matches = bool(
        proof
        and proof[0].is_file()
        and not proof[0].is_symlink()
        and proof[0].read_bytes() == proof[1].read_bytes()
    )
    if not marker_matches and not proof_matches:
        return
    for path in (config, *extra):
        if not path.is_symlink():
            trash_managed(path)
    if active_managed:
        trash_managed(active)


def remove_omp_profiles() -> None:
    root = HOME / ".omp/profiles"
    if not root.is_dir() or root.is_symlink():
        return
    for profile in root.iterdir():
        if not profile.is_dir() or profile.is_symlink():
            continue
        agent = profile / "agent"
        config = agent / "config.yml"
        if (
            config.is_file()
            and not config.is_symlink()
            and config.read_text().startswith("# Generated by omp-profile from ai/omp/")
        ):
            trash_managed(config)
        for name in (
            "AGENTS.md",
            "models.yml",
            "keybindings.yml",
            "mcp.json",
            "WATCHDOG.md",
        ):
            remove_dotfiles_link(agent / name)
        agents = agent / "agents"
        if agents.is_symlink() and agents.readlink() == HOME / ".omp/agent/agents":
            trash_managed(agents)
        try:
            agent.rmdir()
            profile.rmdir()
        except OSError:
            pass
    try:
        root.rmdir()
    except OSError:
        pass


def main() -> int:
    if len(sys.argv) > 1:
        if sys.argv[1:] == ["--help"]:
            print("usage: uninstall-ai")
            return 0
        print("usage: uninstall-ai", file=sys.stderr)
        return 2

    # Reconcile packages, direct links, generated skills, and agent definitions
    # through their existing ownership-aware cleanup paths.
    run(str(DOTFILES / "ai/.bin/configure-ai-tools"))
    run(str(DOTFILES / "ai/.bin/install-agent-commands"))
    run(str(DOTFILES / "ai/.bin/install-agents"))

    for source in (DOTFILES / "ai/.bin").iterdir():
        if source.is_file():
            remove_dotfiles_link(HOME / ".bin" / source.name)

    shim_dir = HOME / ".local/share/mise/shims"
    for name in ("pi", "omp", "codex"):
        destination = HOME / ".local/bin" / name
        if destination.is_symlink() and destination.readlink() == shim_dir / name:
            trash_managed(destination)

    remove_profile(
        HOME / ".pi/agent/settings.json",
        HOME / ".pi/agent/.active-profile",
        DOTFILES / "ai/pi/profiles",
        proof=(
            HOME / ".pi/agent/pi-vcc-config.json",
            DOTFILES / "ai/pi/pi-vcc-config.json",
        ),
        extra=(
            HOME / ".pi/agent/pi-vcc-config.json",
            HOME / ".pi/agent/pi-title.jsonc",
            HOME / ".pi/agent/pi-progress.jsonc",
            HOME / ".pi/web-search.json",
        ),
    )
    remove_profile(
        HOME / ".omp/agent/config.yml",
        HOME / ".omp/agent/.active",
        DOTFILES / "ai/omp/profiles",
        marker="# Generated by omp-profile from ai/omp/",
    )
    remove_profile(
        HOME / ".config/opencode/opencode.jsonc",
        HOME / ".config/opencode/.active",
        DOTFILES / "ai/opencode/profiles",
        marker="// Generated by opencode-profile from ai/opencode/",
    )
    remove_omp_profiles()

    guard_state = HOME / ".local/state/dotfiles/dcg-guards.json"
    if guard_state.is_file() and not guard_state.is_symlink():
        try:
            ownership = json.loads(guard_state.read_text())
        except json.JSONDecodeError:
            ownership = None
        if (
            isinstance(ownership, dict)
            and ownership.get("marker") == "Generated by install-dcg-guards."
        ):
            managed_command = ownership.get("command")
            if isinstance(managed_command, str):
                remove_dcg_hooks(HOME / ".claude/settings.json", managed_command)
                remove_dcg_hooks(HOME / ".codex/hooks.json", managed_command)
            guards = ownership.get("guards")
            if isinstance(guards, list):
                allowed_guards = {
                    HOME / ".omp/agent/extensions/dcg-guard.ts",
                    HOME / ".config/opencode/plugins/dcg-guard.js",
                }
                for guard in guards:
                    path = Path(guard) if isinstance(guard, str) else None
                    if (
                        path in allowed_guards
                        and path.is_file()
                        and not path.is_symlink()
                    ):
                        trash_managed(path)
            trash_managed(guard_state)

    herdr = shutil.which("herdr")
    if herdr:
        for name in ("pi", "omp", "opencode", "claude", "codex"):
            run(herdr, "integration", "uninstall", name)

    remove_generated_file(HOME / ".config/mise/conf.d/40-ai.toml", GENERATED_MARKER)
    remove_generated_file(HOME / ".local/state/dotfiles/ai-tools", GENERATED_MARKER)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
