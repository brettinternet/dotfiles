#!/bin/sh

set -eu

commands_dir=${1:-ai/.agents/commands}
agents_skills_dir=${2:-"$HOME/.agents/skills"}
claude_skills_dir=${3:-"$HOME/.claude/skills"}
claude_commands_dir=${4:-"$HOME/.claude/commands"}
legacy_omp_skills=${5:-"$HOME/.omp/agent/skills"}
opencode_commands_dir=${6:-"$HOME/.config/opencode/commands"}
skill_marker='<!-- Generated by install-agent-commands. -->'
agent_marker='# Generated by install-agent-commands.'
legacy_claude_marker='<!-- Generated by install-agent-commands. -->'
opencode_command_marker='# Generated by install-agent-commands.'

command_description() {
  sed -n 's/^description: //p' "$1" | head -n 1
}

command_argument_hint() {
  sed -n 's/^argument-hint: //p' "$1" | head -n 1
}

command_body() {
  awk 'NR == 1 { next } frontmatter && /^---$/ { frontmatter=0; next } frontmatter { next } { print }' frontmatter=1 "$1"
}

require_managed_skill() {
  skill_dir=$1
  skill="$skill_dir/SKILL.md"

  if [ -L "$skill_dir" ]; then
    printf 'Refusing to replace linked skill directory: %s\n' "$skill_dir" >&2
    exit 1
  fi
  if [ -e "$skill" ] && ! grep -Fqx "$skill_marker" "$skill"; then
    printf 'Refusing to overwrite unmanaged skill: %s\n' "$skill" >&2
    exit 1
  fi
}

require_managed_command() {
  command=$1

  if [ -e "$command" ] && ! grep -Fqx "$opencode_command_marker" "$command" && ! grep -Fqx "$skill_marker" "$command"; then
    printf 'Refusing to overwrite unmanaged OpenCode command: %s\n' "$command" >&2
    exit 1
  fi
}

write_skill() {
  command=$1
  name=$2
  description=$3
  argument_hint=$4
  skill_dir=$5

  mkdir -p "$skill_dir"
  {
    printf '%s\n' '---'
    printf 'name: %s\n' "$name"
    printf 'description: %s\n' "$description"
    if [ -n "$argument_hint" ]; then
      printf 'argument-hint: %s\n' "$argument_hint"
    fi
    printf '%s\n' '---'
    printf '%s\n' "$skill_marker"
    printf '\nWhen explicitly invoked as `$%s`, treat the text supplied with the invocation as `$ARGUMENTS`. Where the command uses `$1`, `$2`, or `$@`, interpret them as the first, second, or all supplied arguments.\n\n' "$name"
    command_body "$command"
  } > "$skill_dir/SKILL.md"
}

write_opencode_command() {
  command=$1
  description=$2
  destination=$3

  mkdir -p "$(dirname "$destination")"
  {
    printf '%s\n' '---' "$opencode_command_marker"
    printf 'description: %s\n' "$description"
    printf '%s\n' '---' ''
    command_body "$command"
  } > "$destination"
}

for command in "$commands_dir"/*.md; do
  [ -f "$command" ] || continue

  name=$(basename "$command" .md)
  description=$(command_description "$command")
  if [ -z "$description" ]; then
    printf 'Missing description in command: %s\n' "$command" >&2
    exit 1
  fi

  agents_skill_dir="$agents_skills_dir/$name"
  claude_skill_dir="$claude_skills_dir/$name"
  agent="$agents_skill_dir/agents/openai.yaml"

  require_managed_skill "$agents_skill_dir"
  require_managed_skill "$claude_skill_dir"
  require_managed_command "$opencode_commands_dir/$name.md"
  if [ -e "$agent" ] && ! grep -Fqx "$agent_marker" "$agent"; then
    printf 'Refusing to overwrite unmanaged skill metadata: %s\n' "$agent" >&2
    exit 1
  fi
done

for command in "$commands_dir"/*.md; do
  [ -f "$command" ] || continue

  name=$(basename "$command" .md)
  description=$(command_description "$command")
  argument_hint=$(command_argument_hint "$command")
  agents_skill_dir="$agents_skills_dir/$name"
  claude_skill_dir="$claude_skills_dir/$name"
  agent="$agents_skill_dir/agents/openai.yaml"

  write_skill "$command" "$name" "$description" "$argument_hint" "$agents_skill_dir"
  write_skill "$command" "$name" "$description" "$argument_hint" "$claude_skill_dir"
  write_opencode_command "$command" "$description" "$opencode_commands_dir/$name.md"

  display_name=$(printf '%s' "$name" | tr '-' ' ')
  mkdir -p "$(dirname "$agent")"
  {
    printf '%s\n' "$agent_marker" 'interface:'
    printf '  display_name: "%s"\n' "$display_name"
    printf '  short_description: "Run the %s command workflow"\n' "$name"
    printf '  default_prompt: "Use $%s with the relevant arguments to run this command workflow."\n' "$name"
    printf '%s\n' 'policy:' '  allow_implicit_invocation: false'
  } > "$agent"

done

cleanup_generated_skills() {
  skills_dir=$1
  require_agent=$2

  for skill in "$skills_dir"/*/SKILL.md; do
    [ -f "$skill" ] || continue

    skill_dir=$(dirname "$skill")
    name=$(basename "$skill_dir")
    agent="$skill_dir/agents/openai.yaml"
    [ ! -f "$commands_dir/$name.md" ] || continue
    grep -Fqx "$skill_marker" "$skill" || continue
    if [ "$require_agent" = true ]; then
      [ -f "$agent" ] && grep -Fqx "$agent_marker" "$agent" || continue
    fi
    trash "$skill_dir"
  done
}

# Reconcile only generated resources after every current command is valid.
cleanup_generated_skills "$agents_skills_dir" true
cleanup_generated_skills "$claude_skills_dir" false

for command in "$opencode_commands_dir"/*.md; do
  [ -f "$command" ] || continue

  name=$(basename "$command" .md)
  [ ! -f "$commands_dir/$name.md" ] || continue
  grep -Fqx "$opencode_command_marker" "$command" || grep -Fqx "$skill_marker" "$command" || continue
  trash "$command"
done

# Skills are slash-invokable in Claude Code. Remove the legacy generated
# command copies so each workflow has exactly one searchable entry.
for command in "$claude_commands_dir"/*.md; do
  [ -f "$command" ] || continue

  grep -Fqx "$legacy_claude_marker" "$command" || continue
  trash "$command"
done

# OMP now discovers the shared ~/.agents/skills location. Remove only the
# obsolete link previously managed by this repository.
if [ -L "$legacy_omp_skills" ]; then
  managed_omp_skills="$(pwd -P)/ai/skills"
  legacy_omp_target="$(readlink "$legacy_omp_skills")"
  if [ "$legacy_omp_target" = "$managed_omp_skills" ] || { [ "${managed_omp_skills#/private}" != "$managed_omp_skills" ] && [ "$legacy_omp_target" = "${managed_omp_skills#/private}" ]; }; then
    trash "$legacy_omp_skills"
  fi
fi

