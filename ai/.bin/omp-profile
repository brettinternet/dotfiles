#!/bin/sh
# omp-profile — manage OMP config profile overlays
# Usage: omp-profile [show|list|use <name>|config|path [<name>|common]|edit [<name>|common]|new <name> [--from <other>]]
set -eu

# Resolve dotfiles root: $DOTFILES env, or walk up from this script's realpath.
# The script is typically invoked via a symlink (stow), so resolve symlinks
# on $0 before walking up — otherwise we'd land in the symlink's dir.
if [ -z "${DOTFILES:-}" ]; then
  _src="$0"
  # Follow symlinks to the real script location (portable; no realpath dep).
  while [ -L "$_src" ]; do
    _dir="$(cd "$(dirname "$_src")" && pwd -P)"
    _src="$(readlink "$_src")"
    case "$_src" in
      /*) ;;                 # absolute target
      *) _src="$_dir/$_src" ;; # relative target, resolve against link dir
    esac
  done
  _self="$(cd "$(dirname "$_src")" && pwd -P)"
  # ai/.bin -> ai -> dotfiles root
  DOTFILES="$(cd "$_self/../.." && pwd -P)"
fi

PROFILES_DIR="$DOTFILES/ai/omp/profiles"
COMMON_PROFILE="$PROFILES_DIR/common.yml"
CONFIG_DIR="$HOME/.omp/agent"
CONFIG_FILE="$CONFIG_DIR/config.yml"
ACTIVE_FILE="$CONFIG_DIR/.active"
LEGACY_ACTIVE_FILE="$DOTFILES/ai/pi/.active"
LEGACY_CONFIG_FILE="$DOTFILES/ai/pi/config.yml"
LEGACY_LOCK_FILE="$DOTFILES/ai/pi/config.yml.lock"
LEGACY_GENERATED_HEADER='# Generated by pi-profile from ai/pi/profiles/common.yml '
GENERATED_HEADER='# Generated by omp-profile from ai/omp/profiles/common.yml '
MERGE_PROFILE="$DOTFILES/ai/omp/merge-profile.py"

die() { printf '%s\n' "$*" >&2; exit 1; }

profile_path() {
  case "$1" in
    common) printf '%s\n' "$COMMON_PROFILE" ;;
    *)      printf '%s/%s.yml\n' "$PROFILES_DIR" "$1" ;;
  esac
}

active_profile() {
  if [ -f "$ACTIVE_FILE" ]; then
    cat "$ACTIVE_FILE"
  elif [ -f "$LEGACY_ACTIVE_FILE" ]; then
    cat "$LEGACY_ACTIVE_FILE"
  else
    echo "codex"
  fi
}

cmd_show() {
  profile="$(active_profile)"
  printf '%s\t%s\n' "$profile" "$(profile_path "$profile")"
}

cmd_list() {
  active="$(active_profile)"
  for f in "$PROFILES_DIR"/*.yml; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .yml)"
    [ "$name" = "common" ] && continue
    if [ "$name" = "$active" ]; then
      printf '* %s\n' "$name"
    else
      printf '  %s\n' "$name"
    fi
  done
}
is_legacy_config_link() {
  [ -L "$CONFIG_FILE" ] || return 1
  legacy_target=$(readlink "$CONFIG_FILE")
  [ "$legacy_target" = "$LEGACY_CONFIG_FILE" ] || { [ "${LEGACY_CONFIG_FILE#/private}" != "$LEGACY_CONFIG_FILE" ] && [ "$legacy_target" = "${LEGACY_CONFIG_FILE#/private}" ]; }
}

is_legacy_active_link() {
  [ -L "$ACTIVE_FILE" ] || return 1
  legacy_target=$(readlink "$ACTIVE_FILE")
  [ "$legacy_target" = "$LEGACY_ACTIVE_FILE" ] || { [ "${LEGACY_ACTIVE_FILE#/private}" != "$LEGACY_ACTIVE_FILE" ] && [ "$legacy_target" = "${LEGACY_ACTIVE_FILE#/private}" ]; }
}

is_managed_active_file() {
  [ -f "$ACTIVE_FILE" ] && [ ! -L "$ACTIVE_FILE" ] || return 1
  active_profile_name=$(cat "$ACTIVE_FILE")
  [ -n "$active_profile_name" ] && [ "$active_profile_name" != common ] && [ -f "$(profile_path "$active_profile_name")" ]
}

require_managed_config() {
  [ ! -e "$CONFIG_FILE" ] && [ ! -L "$CONFIG_FILE" ] && return
  is_legacy_config_link && return
  [ -f "$CONFIG_FILE" ] && sed -n '1p' "$CONFIG_FILE" | grep -Fq "$GENERATED_HEADER" && return
  # OMP rewrites YAML when settings change and drops the generated header.
  # The selected profile is durable out-of-band proof that this config is ours.
  [ -f "$CONFIG_FILE" ] && [ ! -L "$CONFIG_FILE" ] && is_managed_active_file && return
  die "omp-profile: refusing to overwrite unmanaged config: $CONFIG_FILE"
}

require_managed_active_file() {
  if [ -L "$ACTIVE_FILE" ]; then
    is_legacy_active_link && return
    die "omp-profile: refusing to overwrite unmanaged active profile: $ACTIVE_FILE"
  fi
  [ ! -e "$ACTIVE_FILE" ] && return
  is_managed_active_file && return
  die "omp-profile: refusing to overwrite unmanaged active profile: $ACTIVE_FILE"
}

cleanup_legacy_checkout_state() {
  if [ -f "$LEGACY_CONFIG_FILE" ] && sed -n '1p' "$LEGACY_CONFIG_FILE" | grep -Fq "$LEGACY_GENERATED_HEADER"; then
    trash "$LEGACY_CONFIG_FILE"
  fi
  if [ -f "$LEGACY_ACTIVE_FILE" ] && [ "$(cat "$LEGACY_ACTIVE_FILE")" = "$name" ]; then
    trash "$LEGACY_ACTIVE_FILE"
  fi
  if [ -f "$LEGACY_LOCK_FILE" ] && [ ! -s "$LEGACY_LOCK_FILE" ]; then
    trash "$LEGACY_LOCK_FILE"
  fi
}




render_config() {
  name="$1"
  [ "$name" != "common" ] || die "omp-profile: 'common' is a shared base, not a selectable profile"
  target="$(profile_path "$name")"
  [ -f "$COMMON_PROFILE" ] || die "omp-profile: common profile not found (${COMMON_PROFILE})"
  [ -f "$target" ] || die "omp-profile: profile '${name}' not found (${target})"
  [ -f "$MERGE_PROFILE" ] || die "omp-profile: merge helper not found (${MERGE_PROFILE})"
  require_managed_config
  mkdir -p "$CONFIG_DIR"

  tmp="${CONFIG_FILE}.tmp.$$"
  if PYTHONPATH="$DOTFILES/dotbot/lib/pyyaml/lib${PYTHONPATH:+:$PYTHONPATH}" \
    python3 "$MERGE_PROFILE" "$COMMON_PROFILE" "$target" "$tmp"; then
    mv "$tmp" "$CONFIG_FILE"
  else
    rm -f "$tmp"
    return 1
  fi
}

cmd_use() {
  name="${1:-}"
  [ -n "$name" ] || die "usage: omp-profile use <name>"
  require_managed_active_file
  render_config "$name"
  tmp="${ACTIVE_FILE}.tmp.$$"
  printf '%s\n' "$name" > "$tmp"
  mv "$tmp" "$ACTIVE_FILE"
  cleanup_legacy_checkout_state
  default_role="$(awk '
    /^modelRoles:/ { in_roles=1; next }
    /^[^ ]/ { in_roles=0 }
    in_roles && /^  default:/ { print $2; exit }
  ' "$CONFIG_FILE")"
  printf 'switched to %s  (modelRoles.default = %s)\n' "$name" "${default_role:-unknown}"
}

cmd_path() {
  name="${1:-$(active_profile)}"
  target="$(profile_path "$name")"
  [ -f "$target" ] || die "omp-profile: profile '${name}' not found (${target})"
  printf '%s\n' "$target"
}

cmd_config() {
  [ $# -eq 0 ] || die "usage: omp-profile config"
  printf '%s\n' "$CONFIG_FILE"
}

cmd_edit() {
  name="${1:-$(active_profile)}"
  target="$(profile_path "$name")"
  [ -f "$target" ] || die "omp-profile: profile '${name}' not found (${target})"
  "${EDITOR:-vi}" "$target"
}

cmd_new() {
  name="${1:-}"
  [ -n "$name" ] || die "usage: omp-profile new <name> [--from <other>]"
  shift
  from="$(active_profile)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ $# -gt 1 ] || die "usage: omp-profile new <name> [--from <other>]"; from="$2"; shift 2 ;;
      *) die "omp-profile new: unknown option '$1'" ;;
    esac
  done
  [ "$from" != "common" ] || die "omp-profile: 'common' is a shared base, not a profile template"
  src="$(profile_path "$from")"
  dst="$PROFILES_DIR/${name}.yml"
  [ -f "$src" ] || die "omp-profile: source profile '${from}' not found (${src})"
  [ ! -f "$dst" ] || die "omp-profile: profile '${name}' already exists (${dst})"
  cp "$src" "$dst"
  printf 'created %s\n' "$dst"
}

usage() {
  cat <<EOF
usage: omp-profile [show]             print active profile and source profile path
       omp-profile list               list selectable profiles (active marked with *)
       omp-profile use <name>         generate config from common + profile <name>
       omp-profile config             print generated active config path
       omp-profile path [<name>|common]  print source profile path (default: active)
       omp-profile edit [<name>|common]  open source profile in \$EDITOR (default: active)
       omp-profile new <name> [--from <other>]  create new profile overlay (copy from other overlay)
       omp-profile -h|--help          show this help
EOF
}

case "${1:-show}" in
  show)       shift; cmd_show "$@" ;;
  list)       shift; cmd_list "$@" ;;
  use)        shift; cmd_use "$@" ;;
  path)       shift; cmd_path "$@" ;;
  config)    shift; cmd_config "$@" ;;
  edit)       shift; cmd_edit "$@" ;;
  new)        shift; cmd_new "$@" ;;
  -h|--help)  usage ;;
  *)          die "omp-profile: unknown command '${1}'. Try: omp-profile --help" ;;
esac
