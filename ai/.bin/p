#!/usr/bin/env python3
"""Launch Pi with a manifest-backed model and thinking preset."""
from __future__ import annotations

import json
import os
import shlex
import sys
from pathlib import Path

LAUNCHERS_PATH = Path(__file__).resolve().parents[1] / "pi/launchers.json"


def usage() -> None:
    print("usage: p <launcher> [pi arguments...]\n       p list", file=sys.stderr)


def main() -> int:
    if len(sys.argv) < 2:
        usage()
        return 2

    with LAUNCHERS_PATH.open() as source:
        launchers: dict[str, dict[str, object]] = json.load(source)

    key = sys.argv[1]
    if key == "list":
        if len(sys.argv) != 2:
            usage()
            return 2
        for name, launcher in launchers.items():
            model = launcher.get("model")
            thinking = launcher.get("thinking")
            args = launcher.get("args", [])
            summary = []
            if model:
                summary.append(f"{model}{f':{thinking}' if thinking else ''}")
            elif thinking:
                summary.extend(["--thinking", str(thinking)])
            summary.extend(str(argument) for argument in args)
            print(f"{name}\t{shlex.join(summary)}")
        return 0

    if key not in launchers:
        available = ", ".join(launchers)
        print(f"p: unknown launcher {key!r}; available: {available}", file=sys.stderr)
        return 2

    launcher = launchers[key]
    arguments = ["pi"]
    if model := launcher.get("model"):
        arguments.extend(["--model", str(model)])
    if thinking := launcher.get("thinking"):
        arguments.extend(["--thinking", str(thinking)])
    arguments.extend(str(argument) for argument in launcher.get("args", []))
    arguments.extend(sys.argv[2:])
    os.execvp("pi", arguments)


if __name__ == "__main__":
    raise SystemExit(main())
