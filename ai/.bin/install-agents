#!/bin/sh

set -eu

source_dir=${1:-ai/agents}
claude_dir=${2:-"$HOME/.claude/agents"}
pi_dir=${3:-"$HOME/.omp/agents"}
opencode_dir=${4:-"$HOME/.config/opencode/agents"}
codex_dir=${5:-"$HOME/.codex/agents"}
codex_config=${6:-"$HOME/.codex/config.toml"}

# Generated markdown definitions must stay byte-identical to the canonical body,
# so ownership lives in a per-directory manifest instead of an in-file marker.
# Codex TOML keeps its original in-file marker so its output does not change.
manifest_name='.install-agents'
manifest_marker='# Generated by install-agents.'
codex_marker='# Generated by install-codex-agents.'
codex_begin='# BEGIN generated Codex agents'
codex_end='# END generated Codex agents'

field() {
  sed -n "s/^$2: //p" "$1" | head -n 1
}

body() {
  awk '
    NR == 1 { next }
    frontmatter && /^---$/ { frontmatter=0; next }
    frontmatter { next }
    !started && $0 == "" { next }
    { started=1; print }
  ' frontmatter=1 "$1"
}

ships() {
  case " $(field "$1" tools) " in
    *" $2 "*) return 0 ;;
  esac
  return 1
}

manages() {
  manifest="$(dirname "$1")/$manifest_name"

  if [ -f "$manifest" ] && grep -Fqx "$(basename "$1")" "$manifest"; then
    return 0
  fi
  return 1
}

require_managed() {
  if [ -L "$1" ]; then
    printf 'Refusing to replace linked agent definition: %s\n' "$1" >&2
    exit 1
  fi
  if [ -e "$1" ] && ! manages "$1"; then
    printf 'Refusing to overwrite unmanaged agent definition: %s\n' "$1" >&2
    exit 1
  fi
}

# Reap definitions this generator previously wrote that are no longer emitted;
# anything absent from the old manifest is unmanaged and survives.
reconcile() {
  directory=$1
  names=$2
  manifest="$directory/$manifest_name"

  if [ -f "$manifest" ]; then
    while read -r name; do
      case "$name" in '' | '#'*) continue ;; esac
      case "
$names" in *"
$name
"*) continue ;; esac
      [ -e "$directory/$name" ] || continue
      trash "$directory/$name"
    done < "$manifest"
  fi

  {
    printf '%s\n' "$manifest_marker"
    printf '%s' "$names"
  } > "$manifest"
}

for directory in "$claude_dir" "$pi_dir" "$opencode_dir" "$codex_dir"; do
  mkdir -p "$directory"
done
mkdir -p "$(dirname "$codex_config")"
[ -e "$codex_config" ] || : > "$codex_config"

for source in "$source_dir"/*.md; do
  [ -f "$source" ] || continue

  role=$(basename "$source" .md)
  if [ -z "$(field "$source" description)" ]; then
    printf 'Missing agent description in: %s\n' "$source" >&2
    exit 1
  fi
  if [ -z "$(field "$source" tools)" ]; then
    printf 'Missing agent tools in: %s\n' "$source" >&2
    exit 1
  fi

  if ships "$source" claude; then require_managed "$claude_dir/$role.md"; fi
  if ships "$source" pi; then require_managed "$pi_dir/$role.md"; fi
  if ships "$source" opencode; then require_managed "$opencode_dir/$role.md"; fi
  if ships "$source" codex; then
    target="$codex_dir/$role.toml"
    if [ -e "$target" ] && ! grep -Fqx "$codex_marker" "$target"; then
      printf 'Refusing to overwrite unmanaged Codex agent: %s\n' "$target" >&2
      exit 1
    fi
    if grep -q '"""' "$source"; then
      printf 'Agent body contains unsupported TOML triple quotes: %s\n' "$source" >&2
      exit 1
    fi
  fi
done

claude_names=''
pi_names=''
opencode_names=''
codex_roles=''

for source in "$source_dir"/*.md; do
  [ -f "$source" ] || continue

  role=$(basename "$source" .md)
  description=$(field "$source" description)

  if ships "$source" claude; then
    {
      printf '%s\n' '---'
      printf 'name: %s\n' "$role"
      printf 'description: %s\n' "$description"
      printf 'model: %s\n' "$(field "$source" claude-model)"
      printf 'effort: %s\n' "$(field "$source" claude-effort)"
      printf '%s\n\n' '---'
      body "$source"
    } > "$claude_dir/$role.md"
    claude_names="$claude_names$role.md
"
  fi

  if ships "$source" pi; then
    {
      printf '%s\n' '---'
      printf 'name: %s\n' "$role"
      printf 'description: %s\n' "$description"
      printf 'model: %s\n' "$(field "$source" pi-model)"
      printf 'thinking-level: %s\n' "$(field "$source" pi-effort)"
      printf '%s\n\n' '---'
      body "$source"
    } > "$pi_dir/$role.md"
    pi_names="$pi_names$role.md
"
  fi

  # OpenCode takes the name from the filename and the model from the active
  # profile's agent.<role> entry, and wants no blank line after the frontmatter.
  if ships "$source" opencode; then
    {
      printf '%s\n' '---'
      printf 'description: %s\n' "$description"
      printf '%s\n' 'mode: subagent' '---'
      body "$source"
    } > "$opencode_dir/$role.md"
    opencode_names="$opencode_names$role.md
"
  fi

  if ships "$source" codex; then
    target="$codex_dir/$role.toml"
    {
      printf '%s\n' "$codex_marker"
      printf 'model = "%s"\n' "$(field "$source" codex-model)"
      printf 'model_reasoning_effort = "%s"\n' "$(field "$source" codex-effort)"
      printf '%s\n\n' 'developer_instructions = """'
      body "$source"
      printf '%s\n' '"""'
    } > "$target"

    escaped_description=$(printf '%s' "$description" | sed 's/\\/\\\\/g; s/"/\\"/g')
    escaped_target=$(printf '%s' "$target" | sed 's/\\/\\\\/g; s/"/\\"/g')
    codex_roles="$codex_roles
[agents.$role]
description = \"$escaped_description\"
config_file = \"$escaped_target\""
  fi
done

reconcile "$claude_dir" "$claude_names"
reconcile "$pi_dir" "$pi_names"
reconcile "$opencode_dir" "$opencode_names"

for target in "$codex_dir"/*.toml; do
  [ -f "$target" ] || continue

  role=$(basename "$target" .toml)
  if [ -f "$source_dir/$role.md" ] && ships "$source_dir/$role.md" codex; then
    continue
  fi
  grep -Fqx "$codex_marker" "$target" || continue
  trash "$target"
done

tmp=$(mktemp "$codex_config.tmp.XXXXXX")
awk -v begin="$codex_begin" -v end="$codex_end" '
  function flush_blanks() {
    while (blanks > 0) {
      print ""
      blanks--
    }
  }
  $0 == begin { blanks=0; skipping=1; next }
  $0 == end { skipping=0; next }
  skipping { next }
  $0 == "" { blanks++; next }
  { flush_blanks(); print }
' "$codex_config" > "$tmp"
{
  printf '\n%s\n' "$codex_begin"
  printf '%s\n' "$codex_roles"
  printf '%s\n' "$codex_end"
} >> "$tmp"
mv "$tmp" "$codex_config"
