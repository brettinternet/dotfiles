#!/bin/sh
# pi-profile — manage Pi coding-agent settings overlays
set -eu

if [ -z "${DOTFILES:-}" ]; then
  src="$0"
  while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd -P)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  self="$(cd "$(dirname "$src")" && pwd -P)"
  DOTFILES="$(cd "$self/../.." && pwd -P)"
fi

PROFILES_DIR="$DOTFILES/ai/pi/profiles"
COMMON_PROFILE="$PROFILES_DIR/common.json"
CONFIG_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
CONFIG_FILE="$CONFIG_DIR/settings.json"
ACTIVE_FILE="$CONFIG_DIR/.active-profile"
MERGE_PROFILE="$DOTFILES/ai/pi/merge-profile.py"
VCC_CONFIG_SOURCE="$DOTFILES/ai/pi/pi-vcc-config.json"
VCC_CONFIG_FILE="$CONFIG_DIR/pi-vcc-config.json"

die() { printf '%s\n' "$*" >&2; exit 1; }

profile_path() {
  case "$1" in
    common) printf '%s\n' "$COMMON_PROFILE" ;;
    *) printf '%s/%s.json\n' "$PROFILES_DIR" "$1" ;;
  esac
}

active_profile() {
  if [ -f "$ACTIVE_FILE" ]; then
    cat "$ACTIVE_FILE"
  else
    echo codex
  fi
}

is_managed_active_file() {
  [ -f "$ACTIVE_FILE" ] && [ ! -L "$ACTIVE_FILE" ] || return 1
  name=$(cat "$ACTIVE_FILE")
  [ -n "$name" ] && [ "$name" != common ] && [ -f "$(profile_path "$name")" ]
}

require_managed_config() {
  [ ! -e "$CONFIG_FILE" ] && [ ! -L "$CONFIG_FILE" ] && return 0
  [ -f "$CONFIG_FILE" ] && [ ! -L "$CONFIG_FILE" ] && is_managed_active_file && return 0
  die "pi-profile: refusing to overwrite unmanaged settings: $CONFIG_FILE"
}

require_managed_active_file() {
  [ ! -e "$ACTIVE_FILE" ] && [ ! -L "$ACTIVE_FILE" ] && return 0
  is_managed_active_file && return 0
  die "pi-profile: refusing to overwrite unmanaged active profile: $ACTIVE_FILE"
}

render_config() {
  name=$1
  [ "$name" != common ] || die "pi-profile: 'common' is not selectable"
  target=$(profile_path "$name")
  [ -f "$COMMON_PROFILE" ] || die "pi-profile: common profile not found: $COMMON_PROFILE"
  [ -f "$target" ] || die "pi-profile: profile '$name' not found: $target"
  require_managed_config
  mkdir -p "$CONFIG_DIR"
  tmp="$CONFIG_FILE.tmp.$$"
  if python3 "$MERGE_PROFILE" "$COMMON_PROFILE" "$target" "$tmp"; then
    mv "$tmp" "$CONFIG_FILE"
  else
    trash "$tmp" 2>/dev/null || true
    return 1
  fi
}
render_vcc_config() {
  [ -f "$VCC_CONFIG_SOURCE" ] || die "pi-profile: VCC config not found: $VCC_CONFIG_SOURCE"
  [ ! -L "$VCC_CONFIG_FILE" ] || die "pi-profile: refusing to overwrite linked VCC config: $VCC_CONFIG_FILE"
  tmp="$VCC_CONFIG_FILE.tmp.$$"
  cp "$VCC_CONFIG_SOURCE" "$tmp"
  mv "$tmp" "$VCC_CONFIG_FILE"
}

cmd_use() {
  name=${1:-}
  [ -n "$name" ] || die "usage: pi-profile use <name>"
  require_managed_active_file
  render_config "$name"
  render_vcc_config
  tmp="$ACTIVE_FILE.tmp.$$"
  printf '%s\n' "$name" > "$tmp"
  mv "$tmp" "$ACTIVE_FILE"
  printf 'switched to %s\n' "$name"
}

cmd_show() {
  name=$(active_profile)
  printf '%s\t%s\n' "$name" "$(profile_path "$name")"
}

cmd_list() {
  active=$(active_profile)
  for path in "$PROFILES_DIR"/*.json; do
    [ -f "$path" ] || continue
    name=$(basename "$path" .json)
    [ "$name" = common ] && continue
    if [ "$name" = "$active" ]; then
      printf '* %s\n' "$name"
    else
      printf '  %s\n' "$name"
    fi
  done
}

cmd_path() {
  name=${1:-$(active_profile)}
  target=$(profile_path "$name")
  [ -f "$target" ] || die "pi-profile: profile '$name' not found: $target"
  printf '%s\n' "$target"
}

cmd_config() {
  [ $# -eq 0 ] || die "usage: pi-profile config"
  printf '%s\n' "$CONFIG_FILE"
}

cmd_edit() {
  name=${1:-$(active_profile)}
  target=$(profile_path "$name")
  [ -f "$target" ] || die "pi-profile: profile '$name' not found: $target"
  "${EDITOR:-vi}" "$target"
}

usage() {
  cat <<'EOF'
usage: pi-profile [show]                 print active profile
       pi-profile list                   list profiles
       pi-profile use <name>             render and activate a profile
       pi-profile config                 print generated settings path
       pi-profile path [<name>|common]   print source profile path
       pi-profile edit [<name>|common]   edit a source profile
EOF
}

case "${1:-show}" in
  show) shift; cmd_show "$@" ;;
  list) shift; cmd_list "$@" ;;
  use) shift; cmd_use "$@" ;;
  config) shift; cmd_config "$@" ;;
  path) shift; cmd_path "$@" ;;
  edit) shift; cmd_edit "$@" ;;
  -h|--help) usage ;;
  *) die "pi-profile: unknown command '$1'" ;;
esac
