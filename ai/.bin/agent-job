#!/usr/bin/env bash
# Run a named Herdr agent as a scheduled job in this checkout's workspace.
#   agent-job launch NAME PROMPT [GATE]          run one pass; returns once the agent
#                                                finishes its turn and its pane closes
#   agent-job launch --daily NAME PROMPT [GATE]  start once per day; blocks until the agent exits
#   agent-job close NAME                         close the agent once it's done or idle
# GATE is a shell command printing a fingerprint of the pending work: empty output means
# nothing to do, and a nonzero exit fails the run so a broken gate is not mistaken for idle.
# A pass is skipped when the fingerprint matches the one taken before the last completed pass,
# or while the previous pass is still working or blocked; a finished leftover pane is closed first.
# A focused agent pane is never closed or replaced: launch and close skip, and a pass that finishes
# while focused keeps its pane for the user to close.
# Tokens in PROMPT and GATE expand before use; dates are local YYYY-MM-DD. GATE also sees the
# environment directly, but PROMPT reaches the agent only through tokens:
#   {env:NAME}   the value of a nonempty variable, e.g. a job env REVIEWERS: alice,bob
#   {repo}       this checkout's GitHub OWNER/NAME
#   {today}      today's date
#   {yesterday}  one day ago
#   {today-N}    N days ago, e.g. {today-7}
# AGENT_KIND selects the agent CLI (pi, claude, or codex; default pi). A leading /skill:NAME in
# PROMPT becomes /NAME for claude and $NAME for codex.
# Example: agent-job launch review '/skill:pr-review repo:{repo} author:{env:AUTHORS} updated:>={yesterday}'
# Exit 3 = nothing to do (noon records it as noop). macOS only (BSD date).
set -euo pipefail

mode=$1 daily=
if [[ $mode == launch && ${2:-} == --daily ]]; then
  daily=1
  shift
fi
name=$2

# Prints "STATUS FOCUSED", e.g. "done true".
agent_state() {
  local out
  if out=$(herdr agent get "$name" 2>&1); then
    jq -r '.result.agent | "\(.agent_status // "unknown") \(.focused == true)"' <<<"$out"
  elif grep -q agent_not_found <<<"$out"; then
    echo absent false
  else
    echo "herdr agent get $name failed: $out" >&2
    exit 1
  fi
}

expand_tokens() {
  local s=$1 variable
  while [[ $s =~ \{env:([A-Za-z_][A-Za-z0-9_]*)\} ]]; do
    variable=${BASH_REMATCH[1]}
    [[ -n ${!variable:-} ]] || { echo "{env:$variable} is unset or empty" >&2; exit 1; }
    s=${s//"${BASH_REMATCH[0]}"/${!variable}}
  done
  s=${s//"{repo}"/$repo}
  s=${s//"{today}"/$(date +%F)}
  s=${s//"{yesterday}"/$(date -v-1d +%F)}
  while [[ $s =~ \{today-([0-9]+)\} ]]; do
    s=${s//"${BASH_REMATCH[0]}"/$(date -v-"${BASH_REMATCH[1]}"d +%F)}
  done
  printf '%s' "$s"
}

run_gate() {
  bash -c "$gate" || { echo "gate failed" >&2; exit 1; }
}

state=$(agent_state)
read -r status focused <<<"$state"
echo "$name: status=$status focused=$focused"
if [[ $focused == true ]]; then
  echo "focused; leaving it to you"
  exit 3
fi

case $mode in
  launch)
    repo=
    if [[ "$3${4:-}" == *"{repo}"* ]]; then
      repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner) || { echo "cannot resolve {repo}" >&2; exit 1; }
    fi
    prompt=$(expand_tokens "$3")
    gate=$(expand_tokens "${4:-}")
    kind=${AGENT_KIND:-pi}
    case $kind in
      claude) prompt=${prompt/#\/skill:/\/} ;;
      codex) prompt=${prompt/#\/skill:/\$} ;;
    esac
    agent=("$HOME/.bin/agent" "$name" -k "$kind" -w "$(basename "$PWD")" -t "$name" --reuse-tab -C "$PWD"
      --herdr-session default)
    # A daily agent is still needed after a scheduler restart orphans its waiting run. A blocked
    # pass keeps its pane for the user; once answered and finished, the next pass replaces it.
    case $status in
      absent) ;;
      done | idle) [[ -z $daily ]] || exit 3 ;;
      *) exit 3 ;;
    esac
    # NOON_LAST_SUCCESS_AT is the UTC start of the last run whose agent exited normally.
    if [[ -n $daily && -n ${NOON_LAST_SUCCESS_AT:-} ]]; then
      last=$(date -j -u -f %Y-%m-%dT%H:%M:%S "${NOON_LAST_SUCCESS_AT%%[.Z]*}" +%s)
      [[ $(date -r "$last" +%F) == $(date +%F) ]] && { echo "already ran today"; exit 3; }
    fi
    fingerprint=
    if [[ -n $gate ]]; then
      fingerprint=$(run_gate)
      [[ -n $fingerprint ]] || { echo "nothing to do"; exit 3; }
    fi
    [[ -z $daily ]] || exec "${agent[@]}" --wait --prompt "$prompt"
    state="${XDG_STATE_HOME:-$HOME/.local/state}/agent-job/$(basename "$PWD")-$name.gate"
    if [[ -n $fingerprint && -f $state && $(<"$state") == "$fingerprint" ]]; then
      echo "unchanged since last pass"
      exit 3
    fi
    [[ $status == absent ]] || "$HOME/.bin/agent" --close "$name" --herdr-session default
    # Fails, keeping the pane, when the agent blocks on the user.
    "${agent[@]}" --close-on-done --prompt "$prompt"
    mkdir -p "${state%/*}"
    printf '%s' "$fingerprint" >"$state"
    ;;
  close)
    case $status in
      done | idle) exec "$HOME/.bin/agent" --close "$name" --herdr-session default ;;
      *) exit 3 ;;
    esac
    ;;
  *)
    echo "usage: $0 launch [--daily] NAME PROMPT [GATE] | close NAME" >&2
    exit 2
    ;;
esac
