#!/bin/sh
# ai-config — generate and activate manifest-backed Pi profiles
set -eu

if [ -z "${DOTFILES:-}" ]; then
  src="$0"
  while [ -L "$src" ]; do
    source_dir="$(cd "$(dirname "$src")" && pwd -P)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$source_dir/$src" ;; esac
  done
  self="$(cd "$(dirname "$src")" && pwd -P)"
  DOTFILES="$(cd "$self/../.." && pwd -P)"
fi

generator="$DOTFILES/ai/generate-config.py"

die() { printf '%s\n' "$*" >&2; exit 1; }

case "${1:-generate}" in
  generate)
    shift
    exec python3 "$generator" "$@"
    ;;
  check)
    shift
    [ "$#" -eq 0 ] || die "usage: ai-config check"
    exec python3 "$generator" --check
    ;;
  use)
    shift
    [ "$#" -eq 1 ] || die "usage: ai-config use <profile>"
    output=$(python3 "$generator" --profile-output "$1")
    python3 "$generator"
    exec "$DOTFILES/ai/.bin/pi-profile" use "$output"
    ;;
  *)
    die "usage: ai-config [generate [--check]|check|use <profile>]"
    ;;
esac
