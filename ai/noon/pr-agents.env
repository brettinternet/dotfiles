# Template for pr-agents.yaml. Copy next to the project's .git/noon.yaml and fill in; never commit values.
# Logins are comma-separated, e.g. alice,bob.

# Reviewers to request on my PRs.
REVIEWERS=
# Authors whose PRs to review; '*' reviews everyone but me.
REVIEW_AUTHORS=
# Optional extra PR search qualifiers; defaults to draft:false.
# REVIEW_SEARCH=draft:false
# Optional agent CLI: pi, claude, or codex; defaults to pi.
# AGENT_KIND=pi
# Vars
# REVIEW_SCHEDULE='0 6-14 * * 1-4'
# REVIEW_JITTER='20m'
