# Template for pr-agents.yaml. setup.sh copies it to .git/noon/pr-agents.env; fill in values there,
# never here.
# Logins are comma-separated, e.g. alice,bob.

# Authors whose PRs to review; '*' reviews everyone but me.
REVIEW_AUTHORS=
# Optional extra pr-babysit arguments, e.g. reviewers to request on my PRs.
# BABYSIT_ARGS='--reviewer alice,bob'
# Optional extra PR search qualifiers added to draft:false, e.g. only PRs requesting my review.
# REVIEW_SEARCH='review-requested:@me'
# Optional agent CLI: pi, claude, or codex; defaults to pi.
# AGENT_KIND=pi
# Optional native agent CLI arguments; per-job values win, and empty or unset uses agent defaults.
# AGENT_ARGS='--model opus --effort medium'
# BABYSIT_AGENT_ARGS=
# REVIEW_AGENT_ARGS=
# Keep completed panes open before auto-close (integer s/m/h; 0s closes immediately).
# Per-job overrides win. Manual closure during retention succeeds; new work resets the timer.
AGENT_RETENTION=30m
# BABYSIT_RETENTION=30m
# REVIEW_RETENTION=30m
# Total job timeout must cover work plus retention. Increase it for longer retention.
# AGENT_JOB_TIMEOUT=3h
# Vars
# BABYSIT_SCHEDULE='*/15 7-14 * * 1-4'
# BABYSIT_JITTER='5m'
# REVIEW_SCHEDULE='0 6-14 * * 1-4'
# REVIEW_JITTER='20m'
