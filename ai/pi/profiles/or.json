{
  "defaultProvider": "openrouter",
  "defaultModel": "openai/gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openrouter/openai/gpt-5.6-sol",
    "openrouter/openai/gpt-5.6-luna",
    "openrouter/openai/gpt-5.6-sol-pro",
    "openrouter/~anthropic/claude-fable-latest",
    "openrouter/z-ai/glm-5.3",
    "openrouter/anthropic/claude-opus-4.8",
    "openrouter/anthropic/claude-opus-4.6"
  ],
  "subagents": {
    "defaultModel": "openrouter/openai/gpt-5.6-luna",
    "defaultProvider": "openrouter",
    "defaultThinking": "max",
    "agentOverrides": {
      "researcher": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openrouter/anthropic/claude-opus-4.8",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openrouter/openai/gpt-5.6-sol-pro",
        "thinking": "high"
      },
      "explore": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "thinking": "low"
      },
      "executor": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "thinking": "high"
      },
      "verifier": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "thinking": "high"
      },
      "pr-watcher": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "thinking": "low"
      },
      "thermo-nuclear-code-quality-review": {
        "model": "openrouter/openai/gpt-5.6-sol-pro",
        "thinking": "xhigh"
      },
      "writer": {
        "model": "openrouter/anthropic/claude-opus-4.6",
        "thinking": "medium"
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "openrouter/*"
      ]
    }
  },
  "titleConfig": {
    "enabled": true,
    "model": "openrouter/deepseek/deepseek-v4-flash-0731:off",
    "maxTokens": 30,
    "maxLength": 60
  },
  "progressConfig": {
    "model": "openrouter/deepseek/deepseek-v4-flash-0731:off",
    "maxInputChars": 12000,
    "maxTokens": 180,
    "timeoutMs": 60000
  },
  "extensions": [
    "$DOTFILES/ai/pi/extensions/dcg-guard.ts",
    "$DOTFILES/ai/pi/extensions/openrouter-web-search.ts"
  ],
  "webSearchConfig": {
    "tools": {
      "webSearch": {
        "enabled": false
      }
    }
  }
}
