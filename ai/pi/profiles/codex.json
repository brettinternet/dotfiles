      "delegate": { "model": "openai-codex/gpt-5.6-luna", "thinking": "high" },
      "explore": { "model": "openai-codex/gpt-5.6-luna", "thinking": "low" },
      "executor": { "model": "openai-codex/gpt-5.6-luna", "thinking": "max" },
      "verifier": { "model": "openai-codex/gpt-5.6-luna", "thinking": "max" },
