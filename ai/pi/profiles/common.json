{
  "quietStartup": true,
  "hideThinkingBlock": true,
  "theme": "terminal",
  "outputPad": 0,
  "editorPaddingX": 0,
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "ask",
  "steeringMode": "all",
  "followUpMode": "one-at-a-time",
  "tuiMode": "fullscreen",
  "defaultTools": ["+codemode"],
  "extensions": ["$DOTFILES/ai/pi/extensions/dcg-guard.ts"],
  "packages": [
    { "source": "git:github.com/nicobailon/pi-subagents@7fd88df807eddc29bafedc4d9f0c74cebc5fdfe9", "skills": [] },
    "npm:pi-web-access@0.33.0",
    "npm:pi-chrome@0.15.46",
    "npm:@sting8k/pi-vcc@0.7.0",
    "npm:@narumitw/pi-btw@0.57.0",
    "git:github.com/brettinternet/pi-extensions@667b338cfde02e287f32935826e8c8f01bff0f8f"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": { "disabled": true },
      "researcher": { "inheritProjectContext": true, "inheritGlobalContext": true },
      "worker": { "disabled": true },
      "reviewer": { "inheritProjectContext": true, "inheritGlobalContext": true },
      "oracle": { "inheritProjectContext": true, "inheritGlobalContext": true },
      "delegate": { "disabled": true },
      "explore": { "inheritProjectContext": true, "inheritGlobalContext": true },
      "executor": { "inheritProjectContext": true, "inheritGlobalContext": true },
      "verifier": { "inheritProjectContext": true, "inheritGlobalContext": true },
      "pr-watcher": { "inheritProjectContext": true, "inheritGlobalContext": true },
      "thermo-nuclear-code-quality-review": { "inheritProjectContext": true, "inheritGlobalContext": true },
      "cursor-agent": { "disabled": true },
      "cursor-agent-writer": { "disabled": true },
      "claude-code": { "disabled": true },
      "claude-code-writer": { "disabled": true },
      "codex-exec": { "disabled": true },
      "codex-exec-writer": { "disabled": true }
    }
  }
}
