// Generated by opencode-profile from ai/opencode/profiles/common.jsonc + ai/opencode/profiles/gpt.jsonc.
// Edit those source files, not this generated config.
{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "opencode"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "chrome-devtools-mcp@latest"
      ]
    }
  },
  "agent": {
    "executor": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high"
    },
    "pr-watcher": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "thermo-nuclear-code-quality-review": {
      "model": "openai/gpt-5.5",
      "variant": "high"
    },
    "verifier": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    }
  }
}
