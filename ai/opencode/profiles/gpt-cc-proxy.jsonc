{
  "agent": {
    "executor": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast",
    },
    "oracle": {
      "model": "anthropic/claude-opus-4-7",
      "variant": "max",
    },
    "pr-watcher": {
      "model": "openai/gpt-5.4-mini-fast",
    },
    "thermo-nuclear-code-quality-review": {
      "model": "anthropic/claude-opus-4-7",
      "variant": "max",
    },
    "verifier": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
    },
  },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "{env:MERIDIAN_BASE_URL}",
        "apiKey": "dummy",
      },
    },
  },
}
