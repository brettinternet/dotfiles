{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "opencode"
  ],
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "chrome-devtools-mcp@latest",
        "--executable-path",
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "--headless=true",
        "--isolated=true"
      ]
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        }
      }
    },
    "anthropic": {
      "models": {
        "claude-fable-5": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "claude-opus-5": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "claude-opus-4.8": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "claude-sonnet-5": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "claude-haiku-4-5": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "claude-opus-4.6": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "openai/gpt-5.6-sol": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "openai/gpt-5.6-terra": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "openai/gpt-5.6-luna": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "openai/gpt-5.6-sol-pro": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "openai/gpt-latest": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "anthropic/claude-fable-latest": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000
          }
        },
        "anthropic/claude-opus-latest": {
          "limit": {
            "context": 256000,
