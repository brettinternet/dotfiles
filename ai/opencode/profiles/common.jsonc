{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
      },
    },
    "openrouter": {
      "models": {
        "openai/gpt-5.6-sol": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "openai/gpt-5.6-terra": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "openai/gpt-5.6-luna": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "anthropic/claude-opus-4.8": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "~anthropic/claude-opus-latest": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "~anthropic/claude-sonnet-latest": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "~deepseek/deepseek-v4-flash-latest": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "deepseek/deepseek-v4-pro-0813": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
        "z-ai/glm-5.3": {
          "limit": {
            "context": 256000,
            "input": 128000,
            "output": 128000,
          },
        },
      },
    },
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["bunx", "chrome-devtools-mcp@latest"],
    },
  },
}
